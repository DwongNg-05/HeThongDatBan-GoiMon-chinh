<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <!--
    Bảo mật (NU1902/NU1903): System.Security.Cryptography.Pkcs 9.0.18 và 10.0.0 có lỗ hổng
    (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). Gói này được Microsoft.Data.SqlClient / MailKit kéo vào gián tiếp.
    Tham chiếu trực tiếp để mọi project dùng bản vá mới nhất của nhánh 10.0 (lock file ghi lại đúng bản đã chọn).
  -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.*" />
  </ItemGroup>
</Project>

@page
@model RestaurantManagement.Web.Pages.Dishes.CreateModel
@{
    ViewData["Title"] = "Tạo món mới";
}

<h2>Tạo món mới</h2>

<form method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Dish.Name" class="form-label">Tên món</label>
        <input asp-for="Dish.Name" class="form-control" />
        <span asp-validation-for="Dish.Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Nhóm món</label>
        <select asp-for="Dish.CategoryId" class="form-select" asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(Model.Categories, "Id", "Name"))">
            <option value="">-- Chọn nhóm --</option>
        </select>
        <span asp-validation-for="Dish.CategoryId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Dish.PriceVnd" class="form-label">Giá bán (VND)</label>
        <input asp-for="Dish.PriceVnd" class="form-control" />
        <span asp-validation-for="Dish.PriceVnd" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Dish.Unit" class="form-label">Đơn vị tính</label>
        <input asp-for="Dish.Unit" class="form-control" placeholder="ví dụ: cái, phần, tô" />
        <span asp-validation-for="Dish.Unit" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Dish.ShortDescription" class="form-label">Mô tả ngắn</label>
        <input asp-for="Dish.ShortDescription" class="form-control" />
        <span asp-validation-for="Dish.ShortDescription" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ImageFile" class="form-label">Ảnh món</label>
        <input asp-for="ImageFile" type="file" class="form-control" accept="@RestaurantManagement.Web.Services.DishImageRules.AcceptHtml" data-image-preview="dish-image-preview" />
        <div class="form-text">Định dạng JPG hoặc PNG, tối đa 5 MB. Bỏ trống để dùng ảnh mặc định của nhóm món.</div>
        <span asp-validation-for="ImageFile" class="text-danger"></span>
        <img id="dish-image-preview" alt="Xem trước ảnh món" class="mt-2 rounded border" style="max-width:160px;max-height:160px;object-fit:cover" hidden />
    </div>

    <div class="mb-3">
        <label asp-for="Dish.PrepMinutes" class="form-label">Thời gian chế biến (phút)</label>
        <input asp-for="Dish.PrepMinutes" class="form-control" />
        <span asp-validation-for="Dish.PrepMinutes" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Dish.Status" class="form-label">Trạng thái</label>
        <select asp-for="Dish.Status" class="form-select">
            <option value="0">Đang bán</option>
            <option value="1">Ngưng bán</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-page="/Dishes/Index" class="btn btn-secondary">Hủy</a>
</form>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/dish-image-preview.js" asp-append-version="true"></script>
}

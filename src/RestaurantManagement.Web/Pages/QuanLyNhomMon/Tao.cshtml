@page
@model RestaurantManagement.Web.Pages.QuanLyNhomMon.TaoModel
@{ ViewData["Title"] = "Thêm nhóm món"; }
<h1>Thêm nhóm món</h1>
<form method="post" class="col-lg-6">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Ten" class="form-label">Tên nhóm món</label>
        <input asp-for="Ten" class="form-control" aria-describedby="ten-help" />
        <div id="ten-help" class="form-text">Tối đa 50 ký tự. Tên không phân biệt chữ hoa/thường; bỏ khoảng trắng thừa, có phân biệt dấu tiếng Việt.</div>
        <span asp-validation-for="Ten" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ThuTuHienThi" class="form-label">Thứ tự hiển thị</label>
        <input asp-for="ThuTuHienThi" type="number" min="0" max="2147483647" class="form-control" />
        <span asp-validation-for="ThuTuHienThi" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="DangSuDung" class="form-check-input" />
        <label asp-for="DangSuDung" class="form-check-label">Đang sử dụng</label>
    </div>
    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-page="Index" class="btn btn-secondary">Hủy</a>
</form>

@page "{id:int}"
@model RestaurantManagement.Web.Pages.QuanLyNhomMon.TrangThaiModel
@{ ViewData["Title"] = Model.Nhom.DangSuDung ? "Ngừng sử dụng nhóm món" : "Bật lại nhóm món"; }
<h1>@ViewData["Title"]</h1>
@if (Model.Nhom.DangSuDung)
{
    <p>Bạn có chắc muốn ngừng sử dụng nhóm “@Model.Nhom.Ten”? Nhóm và các món thuộc nhóm sẽ không hiển thị trên thực đơn công khai và màn hình gọi món. Dữ liệu nhóm và @Model.SoMon món ăn liên kết vẫn được giữ nguyên. Bạn có thể bật lại nhóm sau.</p>
    <form method="post" asp-page-handler="Ngung">
        <button type="submit" class="btn btn-warning">Xác nhận ngừng sử dụng</button>
        <a asp-page="Index" class="btn btn-secondary">Hủy</a>
    </form>
}
else
{
    <p>Bật lại nhóm “@Model.Nhom.Ten”? Nhóm và các món đang bán sẽ xuất hiện trở lại trên hai thực đơn theo thứ tự đã lưu. Trạng thái bán của từng món không thay đổi.</p>
    <form method="post" asp-page-handler="BatLai">
        <button type="submit" class="btn btn-success">Xác nhận bật lại</button>
        <a asp-page="Index" class="btn btn-secondary">Hủy</a>
    </form>
}

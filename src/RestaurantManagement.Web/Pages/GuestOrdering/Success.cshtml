@page
@model RestaurantManagement.Web.Pages.GuestOrdering.SuccessModel
@{ ViewData["Title"] = "Đã gửi order"; }

<main class="container py-5">
    @if (!Model.IsValid)
    {
        <div class="alert alert-warning">Mã order không hợp lệ.</div>
    }
    else
    {
        <section class="card border-success shadow-sm mx-auto" style="max-width: 42rem">
            <div class="card-body text-center p-5">
                <p class="text-success fw-semibold">✓ Order đã gửi cho bếp</p>
                <h1 class="h2">Mã order của bạn</h1>
                <p class="display-6 text-success mb-4">ORD-@Model.Receipt!.BatchId.ToString("D6")</p>
                <p class="text-muted">Bàn @Model.Receipt.TableCode · Đợt gọi thứ @Model.Receipt.BatchNumber · Các món đang chờ bếp.</p>
                <table class="table text-start mt-4"><thead><tr><th>Món</th><th>Đơn giá</th><th>SL</th><th>Thành tiền</th></tr></thead><tbody>
                    @foreach (var line in Model.Receipt.Lines) { <tr><td>@line.ItemName / @line.Unit</td><td>@RestaurantManagement.Web.Services.MoneyFormat.Vnd(line.UnitPriceVnd)</td><td>@line.Quantity</td><td>@RestaurantManagement.Web.Services.MoneyFormat.Vnd(line.LineTotal)</td></tr> }
                </tbody><tfoot><tr><th colspan="3" class="text-end">Tổng tiền</th><th>@RestaurantManagement.Web.Services.MoneyFormat.Vnd(Model.Receipt.Total)</th></tr></tfoot></table>
            </div>
        </section>
    }
</main>

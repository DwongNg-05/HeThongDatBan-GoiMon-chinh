@model System.Collections.Generic.IReadOnlyList<RestaurantManagement.Web.Services.CategoryWithDishes>
@{
    // Món chưa có ảnh riêng dùng ảnh mặc định của nhóm, rồi tới ảnh mặc định chung.
    string ImageSrc(string? path, string? categoryDefault)
    {
        var image = RestaurantManagement.Web.Services.DishImage.Resolve(path, categoryDefault);
        return image.StartsWith('/') ? Url.Content("~" + image) : image;
    }
    var defaultImage = Url.Content("~" + RestaurantManagement.Web.Services.DishImage.DefaultImage);
    // S2-08 Task 1: món tạm hết / hết trong ngày — nhãn "Tạm hết", khoá nút thêm vào giỏ; tự cập nhật mỗi 3 giây.
    var unavailable = ViewData["UnavailableDishIds"] as IReadOnlySet<int> ?? new HashSet<int>();
}
<div class="menu-intro"><div><p>Chọn số lượng rồi bấm “Thêm vào giỏ”. Món có nhãn “Tạm hết” không gọi được.</p></div><a class="btn btn-outline-primary" href="#cart">Xem giỏ món</a></div>
<div class="menu-workspace" data-availability-url="@Url.Content("~/api/menu/availability")" data-availability-interval="@RestaurantManagement.Web.Services.TemporaryOutRules.PollIntervalMs">
<nav class="menu-categories" aria-label="Nhóm món">
    <h2>Danh mục món</h2>
    @foreach (var category in Model)
    {
        <a class="btn btn-outline-primary" href="#nhom-@category.Id">@category.Name</a>
    }
</nav>
<div class="menu-catalog">
<label for="menu-search" class="menu-search-label">Tìm món</label>
<input id="menu-search" class="form-control mb-4" type="search" placeholder="Tìm tên món ăn…" />
<p id="menu-no-results" class="text-muted" hidden>Không tìm thấy món phù hợp. Hãy thử tên khác.</p>
@if (Model.Count == 0)
{
    <p class="text-muted">Thực đơn hiện chưa có nhóm món đang sử dụng.</p>
}
@foreach (var category in Model)
{
<section class="mb-4" id="nhom-@category.Id" aria-labelledby="tieu-de-nhom-@category.Id" data-nhom-id="@category.Id">
    <h2 id="tieu-de-nhom-@category.Id">@category.Name</h2>
    @if (category.Dishes.Count == 0)
    {
        <p class="text-muted">Chưa có món ăn</p>
    }
<div class="row">
    @foreach (var item in category.Dishes)
    {
        var isOut = unavailable.Contains(item.Id);
        <div class="col-md-4 mb-3 menu-item" data-search="@item.Name" data-availability-id="@item.Id" data-unavailable="@(isOut ? "true" : "false")">
            <div class="card menu-item-card">
                <img class="menu-item-photo" src="@ImageSrc(item.ImagePath, category.DefaultImagePath)" alt="Ảnh món @item.Name" width="112" height="112" loading="lazy"
                     onerror="this.onerror=null;this.src='@defaultImage';" />
                <div class="card-body">
                    <span class="badge bg-warning text-dark mb-1" data-availability-label hidden="@(!isOut)">Tạm hết – không nhận order</span>
                    <h3 class="card-title h5">@item.Name</h3>
                    <p class="card-subtitle mb-2 text-muted">@category.Name</p>
                    <p class="card-text">@item.ShortDescription</p>
                    <p class="card-text"><strong>@item.PriceVnd.ToString("N0")</strong> VND / @item.Unit</p>
                    <p class="card-text"><small class="text-muted">Thời gian chế biến: @item.PrepMinutes phút</small></p>
                    <div class="d-flex align-items-center">
                        <input type="number" min="1" value="1" aria-label="Số lượng @item.Name" class="form-control form-control-sm me-2 qty-input" style="width:80px" data-monid="@item.Id" data-availability-disable disabled="@isOut" />
                        <button type="button" class="btn btn-primary btn-add-to-cart" data-monid="@item.Id" data-ten="@item.Name" data-gia="@item.PriceVnd" data-donvitinh="@item.Unit" data-availability-disable disabled="@isOut">Thêm vào giỏ</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

</section>
}

 </div>
<aside id="cart" class="mb-3 menu-cart" aria-label="Giỏ gọi món">
    <h2>Giỏ gọi món</h2>
    <div id="cart-availability-notice" class="alert alert-warning" role="status" aria-live="polite" hidden></div>
    <p class="text-muted">Giỏ món đang trống.<br />Thêm món bạn thích từ thực đơn bên cạnh.</p>
    <table class="table d-none" id="cartTable">
        <thead>
            <tr><th>Tên</th><th>SL</th><th>Giá</th><th>Thành tiền</th><th></th></tr>
        </thead>
        <tbody></tbody>
        <tfoot>
            <tr><td colspan="3" class="text-end"><strong>Tổng</strong></td><td id="cartTotal">0</td><td></td></tr>
        </tfoot>
    </table>
    <form id="checkoutForm" method="post" asp-page="/Ordering/Checkout">
        <input type="hidden" name="CartJson" id="CartJson" />
        <button id="btnCheckout" type="submit" class="btn btn-success d-none">Gọi món</button>
    </form>
</aside>
</div>

<script>
    (function(){
        const normalize = value => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd').replace(/Đ/g, 'D').toLowerCase();
        document.getElementById('menu-search').addEventListener('input', event => {
            const query = normalize(event.target.value.trim());
            let visible = 0;
            document.querySelectorAll('.menu-item').forEach(item => {
                item.hidden = !normalize(item.dataset.search).includes(query);
                if (!item.hidden) visible++;
            });
            document.getElementById('menu-no-results').hidden = !query || visible > 0;
        });
        const cart = [];
        function updateCartUI(){
            const table = document.getElementById('cartTable');
            const tbody = table.querySelector('tbody');
            tbody.innerHTML = '';
            if(cart.length === 0){
                document.querySelector('#cart p')?.classList.remove('d-none');
                table.classList.add('d-none');
                document.getElementById('btnCheckout').classList.add('d-none');
                return;
            }
            document.querySelector('#cart p')?.classList.add('d-none');
            table.classList.remove('d-none');
            document.getElementById('btnCheckout').classList.remove('d-none');
            let total = 0;
            cart.forEach((it, idx) => {
                const row = document.createElement('tr');
                const lineTotal = it.quantity * it.price;
                total += lineTotal;
                row.innerHTML = `<td></td><td>${it.quantity}</td><td>${it.price.toLocaleString()}</td><td>${lineTotal.toLocaleString()}</td><td><button type="button" class="btn btn-sm btn-danger" data-idx="${idx}">X</button></td>`;
                row.cells[0].textContent = it.name;
                tbody.appendChild(row);
            });
            document.getElementById('cartTotal').innerText = total.toLocaleString();
            // wire up remove buttons
            tbody.querySelectorAll('button[data-idx]').forEach(b => b.addEventListener('click', (e)=>{
                const idx = parseInt(e.currentTarget.getAttribute('data-idx'));
                cart.splice(idx,1);
                updateCartUI();
            }));
            // set hidden json
            document.getElementById('CartJson').value = JSON.stringify(cart);
        }

        // S2-08 Task 1: món vừa chuyển sang "Tạm hết" bị bỏ khỏi giỏ để không gửi order mới.
        document.addEventListener('menu-availability:changed', event => {
            const out = event.detail.unavailable;
            const removed = cart.filter(it => out.has(it.dishId)).map(it => it.name);
            if (removed.length === 0) return;
            for (let i = cart.length - 1; i >= 0; i--) if (out.has(cart[i].dishId)) cart.splice(i, 1);
            const notice = document.getElementById('cart-availability-notice');
            notice.textContent = 'Đã bỏ khỏi giỏ vì món vừa tạm hết: ' + removed.join(', ') + '.';
            notice.hidden = false;
            updateCartUI();
        });

        document.querySelectorAll('.btn-add-to-cart').forEach(btn=>{
            btn.addEventListener('click', ()=>{
                if (btn.disabled) return;
                const dishId = parseInt(btn.getAttribute('data-monid'));
                const name = btn.getAttribute('data-ten');
                const price = parseInt(btn.getAttribute('data-gia'));
                const donvitinh = btn.getAttribute('data-donvitinh');
                const input = document.querySelector(`.qty-input[data-monid="${dishId}"]`);
                const quantity = Math.max(1, parseInt(input.value)||1);
                // if exists, increase
                const existing = cart.find(c=>c.dishId===dishId);
                if(existing){ existing.quantity += quantity; }
                else { cart.push({ dishId, name, quantity, price, donvitinh }); }
                updateCartUI();
            });
        });

        // Recheck availability at the moment the customer submits, then post only
        // the items that are still available. The server performs its own final check.
        document.getElementById('checkoutForm').addEventListener('submit', async function(e){
            e.preventDefault();
            if(cart.length===0 || this.dataset.checkoutBusy === 'true') return false;

            const form = this;
            const checkoutButton = document.getElementById('btnCheckout');
            const notice = document.getElementById('cart-availability-notice');
            const availabilityUrl = document.querySelector('[data-availability-url]')?.getAttribute('data-availability-url');
            form.dataset.checkoutBusy = 'true';
            checkoutButton.disabled = true;

            try {
                if (!availabilityUrl) throw new Error('Không tìm thấy địa chỉ kiểm tra tình trạng món.');
                const availabilityResponse = await fetch(availabilityUrl, {
                    cache: 'no-store', credentials: 'same-origin', headers: { 'Accept': 'application/json' }
                });
                if (!availabilityResponse.ok) throw new Error('Chưa kiểm tra được tình trạng món. Vui lòng thử lại.');
                const availability = await availabilityResponse.json();
                const unavailable = new Set(availability.unavailable || []);
                const removed = cart.filter(item => unavailable.has(item.dishId));

                if (removed.length) {
                    for (let i = cart.length - 1; i >= 0; i--) {
                        if (unavailable.has(cart[i].dishId)) cart.splice(i, 1);
                    }
                    notice.textContent = 'Đã bỏ khỏi giỏ vì món vừa tạm hết: ' + [...new Set(removed.map(item => item.name))].join(', ') + '.';
                    notice.hidden = false;
                    updateCartUI();
                }

                if (!cart.length) return false;
                document.getElementById('CartJson').value = JSON.stringify(cart);
                const result = await fetch(form.action, {
                    method: 'POST', body: new FormData(form), credentials: 'same-origin',
                    headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
                });

                if (result.redirected) {
                    window.location.assign(result.url);
                    return false;
                }
                if (result.ok) {
                    const data = await result.json();
                    if (data.redirectUrl) window.location.assign(data.redirectUrl);
                    return false;
                }

                const data = await result.json().catch(() => null);
                if (data?.unavailableDishIds?.length) {
                    const unavailableIds = new Set(data.unavailableDishIds);
                    for (let i = cart.length - 1; i >= 0; i--) {
                        if (unavailableIds.has(cart[i].dishId)) cart.splice(i, 1);
                    }
                    updateCartUI();
                }
                notice.textContent = data?.message || 'Không thể gửi đơn hàng. Vui lòng kiểm tra lại giỏ món và thử lại.';
                notice.hidden = false;
            } catch (error) {
                notice.textContent = error.message || 'Mất kết nối tới máy chủ. Vui lòng thử lại.';
                notice.hidden = false;
            } finally {
                form.dataset.checkoutBusy = 'false';
                checkoutButton.disabled = false;
            }
            return false;
        });
    })();
</script>
<script src="~/js/menu-availability.js" asp-append-version="true"></script>

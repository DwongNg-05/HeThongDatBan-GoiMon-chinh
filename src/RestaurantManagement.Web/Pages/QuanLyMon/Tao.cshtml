@page
@model RestaurantManagement.Web.Pages.QuanLyMon.TaoModel
@{
    ViewData["Title"] = "Tạo món mới";
}

<h2>Tạo món mới</h2>

<form method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Mon.Ten" class="form-label">Tên món</label>
        <input asp-for="Mon.Ten" class="form-control" />
        <span asp-validation-for="Mon.Ten" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Nhóm món</label>
        <select asp-for="Mon.NhomMonId" class="form-select" asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(Model.DanhSachNhom, "Id", "Ten"))">
            <option value="">-- Chọn nhóm --</option>
        </select>
        <span asp-validation-for="Mon.NhomMonId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Mon.GiaBanVnd" class="form-label">Giá bán (VND)</label>
        <input asp-for="Mon.GiaBanVnd" class="form-control" />
        <span asp-validation-for="Mon.GiaBanVnd" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Mon.DonViTinh" class="form-label">Đơn vị tính</label>
        <input asp-for="Mon.DonViTinh" class="form-control" placeholder="ví dụ: cái, phần, tô" />
        <span asp-validation-for="Mon.DonViTinh" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Mon.MoTaNgan" class="form-label">Mô tả ngắn</label>
        <input asp-for="Mon.MoTaNgan" class="form-control" />
        <span asp-validation-for="Mon.MoTaNgan" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="AnhMon" class="form-label">Ảnh món</label>
        <input asp-for="AnhMon" type="file" class="form-control" accept="@RestaurantManagement.Web.Services.QuyTacAnhMonAn.AcceptHtml" data-anh-preview="anh-mon-preview" />
        <div class="form-text">Định dạng JPG hoặc PNG, tối đa 5 MB. Bỏ trống để dùng ảnh mặc định của nhóm món.</div>
        <span asp-validation-for="AnhMon" class="text-danger"></span>
        <img id="anh-mon-preview" alt="Xem trước ảnh món" class="mt-2 rounded border" style="max-width:160px;max-height:160px;object-fit:cover" hidden />
    </div>

    <div class="mb-3">
        <label asp-for="Mon.ThoiGianCheBienPhut" class="form-label">Thời gian chế biến (phút)</label>
        <input asp-for="Mon.ThoiGianCheBienPhut" class="form-control" />
        <span asp-validation-for="Mon.ThoiGianCheBienPhut" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Mon.TrangThai" class="form-label">Trạng thái</label>
        <select asp-for="Mon.TrangThai" class="form-select">
            <option value="0">Đang bán</option>
            <option value="1">Ngưng bán</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-page="/QuanLyMon/Index" class="btn btn-secondary">Hủy</a>
</form>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/anh-mon-preview.js" asp-append-version="true"></script>
}

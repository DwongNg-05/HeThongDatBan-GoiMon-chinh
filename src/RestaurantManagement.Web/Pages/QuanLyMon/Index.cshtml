@page
@model RestaurantManagement.Web.Pages.QuanLyMon.IndexModel
@{
    ViewData["Title"] = "Quản lý món";
    string AnhSrc(string? duongDan)
    {
        var anh = RestaurantManagement.Web.Services.AnhMonAn.ChonAnh(duongDan);
        return anh.StartsWith('/') ? Url.Content("~" + anh) : anh;
    }
}

<div class="d-flex flex-wrap gap-3 justify-content-between align-items-start mt-3 mb-3">
    <div>
        <h1 class="h2 mb-1">Quản lý món</h1>
        <p class="text-muted mb-0">Muốn đổi tên, ảnh hoặc <strong>giá bán</strong> của món, bấm <strong>“Sửa”</strong> ở dòng món đó.
            @if (Model.LaQuanLy)
            {
                <span>Mọi lần đổi giá đều được ghi lại ở mục <a href="#nhat-ky-gia">Nhật ký thay đổi giá</a> bên dưới.</span>
            }
        </p>
    </div>
    <a asp-page="/QuanLyMon/Tao" class="btn btn-primary btn-lg">+ Tạo món mới</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="status">✔ @success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">⚠ @error</div>
}

<div class="table-responsive">
<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>#</th>
            <th>Ảnh</th>
            <th>Tên món</th>
            <th>Giá bán</th>
            <th>Đơn vị</th>
            <th>Thời gian (phút)</th>
            <th>Trạng thái</th>
            @if (Model.LaQuanLy)
            {
                <th>Hôm nay</th>
            }
            <th></th>
        </tr>
    </thead>
    <tbody>
    @{
        int idx = 1;
    }
    @foreach(var item in Model.DanhSachMonAn)
    {
        <tr>
            <td>@idx</td>
            <td><img src="@AnhSrc(item.DuongDanAnh)" alt="Ảnh món @item.Ten" width="56" height="56" style="object-fit:cover;border-radius:8px" loading="lazy" /></td>
            <td>@item.Ten</td>
            <td class="text-nowrap fw-semibold">@(item.GiaBanVnd.ToString("N0")) VND</td>
            <td>@item.DonViTinh</td>
            <td>@item.ThoiGianCheBienPhut</td>
            <td>
                @if(item.TrangThai == RestaurantManagement.Data.Models.TrangThaiMon.DangBan)
                {
                    <span class="badge bg-success">Đang bán</span>
                }
                else
                {
                    <span class="badge bg-secondary">Ngưng bán</span>
                }
            </td>
            @if (Model.LaQuanLy)
            {
                var tamHet = Model.TamHet.TryGetValue(item.Id, out var het) && het;
                <td>
                    <form asp-controller="Management" asp-action="Availability" method="post" class="d-flex flex-wrap align-items-center gap-2">
                        <input type="hidden" name="id" value="@item.Id" />
                        <input type="hidden" name="soldOut" value="@((!tamHet).ToString().ToLowerInvariant())" />
                        <span class="badge @(tamHet ? "bg-warning text-dark" : "bg-light text-dark border")">@(tamHet ? "Tạm hết" : "Còn món")</span>
                        <button type="submit" class="btn btn-sm btn-outline-secondary text-nowrap">@(tamHet ? "Mở bán lại" : "Báo hết")</button>
                    </form>
                </td>
            }
            <td class="text-nowrap">
                <a asp-page="/QuanLyMon/Sua" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                @if (Model.LaQuanLy)
                {
                    <a asp-page="/QuanLyMon/NhatKyGia" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary ms-1">Lịch sử giá</a>
                }
            </td>
        </tr>
        idx++;
    }
    </tbody>
</table>
</div>

@if (Model.LaQuanLy)
{
    <section id="nhat-ky-gia" class="mt-4" aria-labelledby="tieu-de-nhat-ky-gia">
        <h2 id="tieu-de-nhat-ky-gia" class="h4 mb-1">Nhật ký thay đổi giá</h2>
        <p class="text-muted">@RestaurantManagement.Web.Pages.QuanLyMon.IndexModel.SoDongNhatKyGia lần đổi giá gần nhất. Nhật ký chỉ để xem, được ghi tự động mỗi khi giá món thay đổi và không thể chỉnh sửa.</p>
        <div class="table-responsive">
        <table class="table align-middle" id="bang-nhat-ky-gia">
            <thead><tr><th>Thời gian (UTC+7)</th><th>Người sửa</th><th>Món</th><th>Giá cũ</th><th>Giá mới</th></tr></thead>
            <tbody>
            @if (Model.NhatKyGia.Count == 0)
            {
                <tr><td colspan="5" class="text-muted">Chưa có lần đổi giá nào. Khi bạn đổi giá ở trang “Sửa”, thay đổi sẽ hiện tại đây.</td></tr>
            }
            @foreach (var e in Model.NhatKyGia)
            {
                <tr>
                    <td class="text-nowrap">@e.ThoiDiem.AddHours(7).ToString("dd/MM/yyyy HH:mm:ss")</td>
                    <td>@e.NguoiSua</td>
                    <td>@e.TenMon</td>
                    <td class="text-nowrap">@e.GiaCuVnd.ToString("N0") VND</td>
                    <td class="text-nowrap fw-semibold">@e.GiaMoiVnd.ToString("N0") VND <span class="@(e.GiaMoiVnd > e.GiaCuVnd ? "text-danger" : "text-success")">@(e.GiaMoiVnd > e.GiaCuVnd ? "▲" : "▼")</span></td>
                </tr>
            }
            </tbody>
        </table>
        </div>
    </section>
}

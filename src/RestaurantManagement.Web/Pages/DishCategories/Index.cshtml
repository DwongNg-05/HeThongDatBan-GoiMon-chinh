@page
@model RestaurantManagement.Web.Pages.DishCategories.IndexModel
@{ ViewData["Title"] = "Quản lý nhóm món"; }
<h1>Quản lý nhóm món</h1>
@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success" role="status">@Model.StatusMessage</div>
}
<a class="btn btn-primary mb-3" asp-page="Create">Thêm nhóm món</a>
<a class="btn btn-outline-primary mb-3" asp-page="Reorder">Sắp xếp nhóm món</a>
<div class="table-responsive">
<table class="table table-striped">
    <thead><tr><th scope="col">Tên nhóm món</th><th scope="col">Trạng thái</th><th scope="col">Thứ tự hiển thị</th><th scope="col">Thao tác</th></tr></thead>
    <tbody>
    @foreach (var category in Model.Categories)
    {
        <tr>
            <td>@category.Name</td><td>@(category.IsActive ? "Đang sử dụng" : "Ngừng sử dụng")</td><td>@category.SortOrder</td>
            <td><a asp-page="Edit" asp-route-id="@category.Id" aria-label="Sửa tên @category.Name">Sửa tên</a>
                <a class="ms-3" asp-page="Status" asp-route-id="@category.Id">@(category.IsActive ? "Ngừng sử dụng" : "Bật lại")</a>
                <a class="ms-3 text-danger" asp-page="Delete" asp-route-id="@category.Id" aria-label="Xóa nhóm @category.Name">Xóa</a>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
@if (Model.Categories.Count == 0) { <p>Chưa có nhóm món.</p> }

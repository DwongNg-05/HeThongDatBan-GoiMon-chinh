@model RestaurantManagement.Web.Models.Reservations.ReservationLookup
@{ ViewData["Title"]="Tra cứu đặt bàn"; }
<div class="card mx-auto p-4" style="max-width:640px">
<h1 class="h3">Tra cứu đặt bàn</h1>
<p>Nhập mã đặt bàn và số điện thoại đã dùng khi đặt. Không cần đăng nhập.</p>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<form asp-action="Index" method="post">
<div class="mb-3"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control" maxlength="6" required autocomplete="off" /></div>
<div class="mb-3"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" type="tel" inputmode="numeric" maxlength="10" required autocomplete="tel" /></div>
<button class="btn btn-primary" type="submit">Tra cứu</button>
</form>
@if(Model.Result is {} booking)
{
<section class="mt-4" aria-labelledby="lookup-result" role="status">
<h2 id="lookup-result" class="h4">Lượt đặt @booking.Code</h2>
<dl><dt>Trạng thái</dt><dd>@booking.StatusLabel</dd><dt>Giờ hẹn (Việt Nam)</dt><dd>@booking.StartsAt.ToString("dd/MM/yyyy HH:mm")</dd><dt>Số khách</dt><dd>@booking.GuestCount</dd>
@if(booking.Status=="Rejected") { <dt>Lý do từ chối</dt><dd>@booking.RejectionText</dd> }
@if(booking.Status=="Confirmed" && booking.TableCode!=null) { <dt>Bàn đã giữ</dt><dd>@booking.TableCode</dd> }
</dl>
</section>
}
</div>

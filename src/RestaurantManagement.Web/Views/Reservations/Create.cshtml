@model RestaurantManagement.Web.Models.Reservations.ReservationCreateViewModel

@{
    ViewData["Title"] = "Đặt bàn";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h2 class="mb-4">
                        Đặt bàn
                    </h2>


                    <!-- ============================= -->
                    <!-- THÔNG BÁO LỖI -->
                    <!-- ============================= -->

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>


                    <form asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()


                        <!-- ============================= -->
                        <!-- TÊN KHÁCH HÀNG -->
                        <!-- ============================= -->

                        <div class="mb-3">

                            <label asp-for="CustomerName"
                                   class="form-label">
                            </label>

                            <input asp-for="CustomerName"
                                   class="form-control"
                                   placeholder="Nguyễn Văn A" />

                            <span asp-validation-for="CustomerName"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ============================= -->
                        <!-- SỐ ĐIỆN THOẠI -->
                        <!-- ============================= -->

                        <div class="mb-3">

                            <label asp-for="Phone"
                                   class="form-label">
                            </label>

                            <input asp-for="Phone"
                                   class="form-control"
                                   placeholder="0912345678" />

                            <span asp-validation-for="Phone"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ============================= -->
                        <!-- SỐ KHÁCH -->
                        <!-- ============================= -->

                        <div class="mb-3">

                            <label asp-for="GuestCount"
                                   class="form-label">
                            </label>

                            <input asp-for="GuestCount"
                                   type="number"
                                   min="1"
                                   max="20"
                                   class="form-control" />

                            <span asp-validation-for="GuestCount"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ============================= -->
                        <!-- THỜI GIAN -->
                        <!-- ============================= -->

                        <div class="mb-3">

                            <label asp-for="StartsAt"
                                   class="form-label">
                                Thời gian đặt bàn (giờ Việt Nam)
                            </label>

                            <input asp-for="StartsAt"
                                   type="datetime-local"
                                   step="60"
                                   data-schedule-url="@Url.Action("CheckSchedule", "Reservations")"
                                   asp-format="{0:yyyy-MM-ddTHH:mm}"
                                   class="form-control" />

                            <div class="form-text">
                                Asia/Ho_Chi_Minh (UTC+7): nhập giờ tại Việt Nam dù thiết bị đang ở múi giờ khác.
                                Các lượt cách nhau 30 phút tính từ giờ mở cửa của ngày đã chọn.
                                Giờ nhận bàn phải trước giờ đóng cửa.
                            </div>

                            <span asp-validation-for="StartsAt"
                                  class="text-danger">
                            </span>
                            <div id="booking-schedule-feedback" aria-live="polite" class="mt-2"></div>

                        </div>


                        <!-- ============================= -->
                        <!-- KHU VỰC -->
                        <!-- ============================= -->

                        <div class="mb-3">

                            <label asp-for="PreferredAreaId"
                                   class="form-label">
                                Khu vực mong muốn
                            </label>

                            <select asp-for="PreferredAreaId"
                                    class="form-select">

                                <option value="">
                                    -- Không yêu cầu khu vực --
                                </option>

                                @foreach (var area in Model.Areas)
                                {
                                    <option value="@area.Id">
                                        @area.Name
                                    </option>
                                }

                            </select>

                            <div class="form-text">
                                Chỉ hiển thị các khu vực đang hoạt động.
                                Nếu không yêu cầu khu vực, hãy để mặc định.
                            </div>

                            <span asp-validation-for="PreferredAreaId"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ============================= -->
                        <!-- CHỌN BÀN: mã bàn là mã khách nhận -->
                        <!-- ============================= -->

                        <div class="mb-3">

                            <label asp-for="TableId" class="form-label"></label>

                            <select asp-for="TableId"
                                    class="form-select"
                                    required
                                    data-tables-url="@Url.Action("AvailableTables", "Reservations")">
                                <option value="">-- Chọn bàn còn trống --</option>
                                @foreach (var table in Model.Tables)
                                {
                                    <option value="@table.Id" selected="@(Model.TableId == table.Id)">@table.Label</option>
                                }
                            </select>

                            <div class="form-text">
                                Danh sách chỉ gồm bàn còn trống theo giờ, số khách và khu vực bạn chọn.
                                Mã bàn (ví dụ A05) sẽ hiện trên trang xác nhận và trong email.
                            </div>

                            <span asp-validation-for="TableId" class="text-danger"></span>
                            <div id="booking-tables-feedback" aria-live="polite" class="mt-2 @(Model.Tables.Count == 0 ? "text-danger" : "")">
                                @(Model.Tables.Count == 0 ? "Không còn bàn trống phù hợp trong khung giờ này. Vui lòng chọn giờ, số khách hoặc khu vực khác." : "")
                            </div>

                        </div>


                        <!-- ============================= -->
                        <!-- EMAIL -->
                        <!-- ============================= -->

                        <div class="mb-3">

                            <label asp-for="Email"
                                   class="form-label">
                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   placeholder="example@gmail.com" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ============================= -->
                        <!-- GHI CHÚ -->
                        <!-- ============================= -->

                        <div class="mb-3">

                            <label asp-for="Notes"
                                   class="form-label">
                            </label>

                            <textarea asp-for="Notes"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Ví dụ: Muốn ngồi gần cửa sổ"></textarea>

                            <span asp-validation-for="Notes"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ============================= -->
                        <!-- NÚT -->
                        <!-- ============================= -->

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">

                                Đặt bàn

                            </button>


                            <a asp-action="Index"
                               class="btn btn-secondary">

                                Xem đặt bàn

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/booking-schedule.js" asp-append-version="true"></script>
    <script src="~/js/booking-tables.js" asp-append-version="true"></script>

}

@model RestaurantManagement.Web.Models.Reservations.ReservationCreateViewModel

@{
    ViewData["Title"] = "Đặt bàn";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h2 class="mb-4">
                        Đặt bàn
                    </h2>


                    <!-- ============================= -->
                    <!-- THÔNG BÁO LỖI -->
                    <!-- ============================= -->

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>


                    <form asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()


                        <!-- ============================= -->
                        <!-- TÊN KHÁCH HÀNG -->
                        <!-- ============================= -->

                        <div class="mb-3">

                            <label asp-for="CustomerName"
                                   class="form-label">
                            </label>

                            <input asp-for="CustomerName"
                                   class="form-control"
                                   placeholder="Nguyễn Văn A" />

                            <span asp-validation-for="CustomerName"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ============================= -->
                        <!-- SỐ ĐIỆN THOẠI -->
                        <!-- ============================= -->

                        <div class="mb-3">

                            <label asp-for="Phone"
                                   class="form-label">
                            </label>

                            <input asp-for="Phone"
                                   class="form-control"
                                   placeholder="0912345678" />

                            <span asp-validation-for="Phone"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ============================= -->
                        <!-- SỐ KHÁCH -->
                        <!-- ============================= -->

                        <div class="mb-3">

                            <label asp-for="GuestCount"
                                   class="form-label">
                            </label>

                            <input asp-for="GuestCount"
                                   type="number"
                                   min="1"
                                   max="20"
                                   class="form-control" />

                            <span asp-validation-for="GuestCount"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ============================= -->
                        <!-- THỜI GIAN -->
                        <!-- ============================= -->

                        <div class="mb-3">

                            <label asp-for="StartsAt"
                                   class="form-label">
                                Thời gian đặt bàn
                            </label>

                            <input asp-for="StartsAt"
                                   type="datetime-local"
                                   step="1800"
                                   asp-format="{0:yyyy-MM-ddTHH:mm}"
                                   class="form-control" />

                            <div class="form-text">
                                Chọn giờ từ <strong>08:00</strong>
                                đến <strong>21:30</strong>.
                                Thời gian phải theo mốc 30 phút.
                            </div>

                            <span asp-validation-for="StartsAt"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ============================= -->
                        <!-- KHU VỰC -->
                        <!-- ============================= -->

                        <div class="mb-3">

                            <label asp-for="PreferredAreaId"
                                   class="form-label">
                                Khu vực mong muốn
                            </label>

                            <select asp-for="PreferredAreaId"
                                    class="form-select">

                                <option value="">
                                    -- Không yêu cầu khu vực --
                                </option>

                                @foreach (var area in Model.Areas)
                                {
                                    <option value="@area.Id">
                                        @area.Name
                                    </option>
                                }

                            </select>

                            <div class="form-text">
                                Chỉ hiển thị các khu vực đang hoạt động.
                                Nếu không yêu cầu khu vực, hãy để mặc định.
                            </div>

                            <span asp-validation-for="PreferredAreaId"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ============================= -->
                        <!-- EMAIL -->
                        <!-- ============================= -->

                        <div class="mb-3">

                            <label asp-for="Email"
                                   class="form-label">
                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   placeholder="example@gmail.com" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ============================= -->
                        <!-- GHI CHÚ -->
                        <!-- ============================= -->

                        <div class="mb-3">

                            <label asp-for="Notes"
                                   class="form-label">
                            </label>

                            <textarea asp-for="Notes"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Ví dụ: Muốn ngồi gần cửa sổ"></textarea>

                            <span asp-validation-for="Notes"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ============================= -->
                        <!-- NÚT -->
                        <!-- ============================= -->

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">

                                Đặt bàn

                            </button>


                            <a asp-action="Index"
                               class="btn btn-secondary">

                                Xem đặt bàn

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
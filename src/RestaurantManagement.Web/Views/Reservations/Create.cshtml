@model RestaurantManagement.Web.Models.Reservations.ReservationCreateViewModel

@{
    ViewData["Title"] = "Đặt bàn";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h2 class="mb-4">
                        Đặt bàn
                    </h2>


                    <!-- ============================= -->
                    <!-- THÔNG BÁO LỖI -->
                    <!-- ============================= -->

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>


                    @if (TempData[RestaurantManagement.Web.Authentication.BookingAntiforgeryRecoveryFilter.MessageKey] is string formMessage)
                    {
                        <div class="alert alert-warning" role="alert">@formMessage</div>
                    }
                    <form asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()


                        <!-- ============================= -->
                        <!-- TÊN KHÁCH HÀNG -->
                        <!-- ============================= -->

                        <div class="mb-3">

                            <label asp-for="CustomerName"
                                   class="form-label">
                            </label>

                            <input asp-for="CustomerName"
                                   class="form-control"
                                   placeholder="Nguyễn Văn A" />

                            <span asp-validation-for="CustomerName"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ============================= -->
                        <!-- SỐ ĐIỆN THOẠI -->
                        <!-- ============================= -->

                        <div class="mb-3">

                            <label asp-for="Phone"
                                   class="form-label">
                            </label>

                            <input asp-for="Phone"
                                   class="form-control"
                                   placeholder="0912345678" />

                            <span asp-validation-for="Phone"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ============================= -->
                        <!-- SỐ KHÁCH -->
                        <!-- ============================= -->

                        <div class="mb-3">

                            <label asp-for="GuestCount"
                                   class="form-label">
                            </label>

                            <input asp-for="GuestCount"
                                   type="number"
                                   min="1"
                                   max="20"
                                   class="form-control" />

                            <span asp-validation-for="GuestCount"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ============================= -->
                        <!-- THỜI GIAN -->
                        <!-- ============================= -->

                        <div class="mb-3">

                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <label asp-for="ReservationDate" class="form-label">Ngày đặt bàn</label>
                                    <input asp-for="ReservationDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" required />
                                    <span asp-validation-for="ReservationDate" class="text-danger"></span>
                                </div>
                                <div class="col-sm-6">
                                    <label asp-for="ReservationTime" class="form-label">Giờ đặt bàn</label>
                                    <input asp-for="ReservationTime" type="time" asp-format="{0:HH:mm}" step="60" class="form-control" required />
                                    <span asp-validation-for="ReservationTime" class="text-danger"></span>
                                </div>
                            </div>
                            <input asp-for="StartsAt" type="hidden" asp-format="{0:yyyy-MM-ddTHH:mm}" data-schedule-url="@Url.Action("CheckSchedule", "Reservations")" />

                            <div class="form-text">
                                Asia/Ho_Chi_Minh (UTC+7): nhập giờ tại Việt Nam dù thiết bị đang ở múi giờ khác.
                                Các lượt cách nhau 30 phút tính từ giờ mở cửa của ngày đã chọn.
                                Giờ nhận bàn phải trước giờ đóng cửa.
                            </div>

                            <span asp-validation-for="StartsAt"
                                  class="text-danger">
                            </span>
                            <div id="booking-schedule-feedback" aria-live="polite" class="mt-2"></div>

                        </div>


                        <!-- ============================= -->
                        <!-- KHU VỰC -->
                        <!-- ============================= -->

                        <div class="mb-3">

                            <label asp-for="PreferredAreaId"
                                   class="form-label">
                                Khu vực mong muốn
                            </label>

                            <select asp-for="PreferredAreaId"
                                    class="form-select">

                                <option value="">
                                    -- Không yêu cầu khu vực --
                                </option>

                                @foreach (var area in Model.Areas)
                                {
                                    <option value="@area.Id">
                                        @area.Name
                                    </option>
                                }

                            </select>

                            <div class="form-text">
                                Chỉ hiển thị các khu vực đang hoạt động.
                                Nếu không yêu cầu khu vực, hãy để mặc định.
                            </div>

                            <span asp-validation-for="PreferredAreaId"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ============================= -->
                        <!-- EMAIL -->
                        <!-- ============================= -->

                        <div class="mb-3">

                            <label asp-for="Email"
                                   class="form-label">
                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   placeholder="example@gmail.com" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ============================= -->
                        <!-- GHI CHÚ -->
                        <!-- ============================= -->

                        <div class="mb-3">

                            <label asp-for="Notes"
                                   class="form-label">
                            </label>

                            <textarea asp-for="Notes"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Ví dụ: Muốn ngồi gần cửa sổ"></textarea>

                            <span asp-validation-for="Notes"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ============================= -->
                        <!-- NÚT -->
                        <!-- ============================= -->

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">

                                Đặt bàn

                            </button>


                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <a asp-action="Index"
                                   class="btn btn-secondary">

                                    Xem đặt bàn

                                </a>
                            }
                            else
                            {
                                <a asp-controller="Menu" asp-action="Index"
                                   class="btn btn-secondary">

                                    Xem thực đơn

                                </a>
                            }

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/booking-schedule.js" asp-append-version="true"></script>

}

@model RestaurantManagement.Web.Models.Reservations.ReservationDetailsViewModel
@{
    ViewData["Title"] = "Chi tiết đặt bàn";
    var r = Model.Reservation;
}
@section Styles {
    <link rel="stylesheet" href="~/css/reservation-email.css" asp-append-version="true" />
}
<h2>Đặt bàn @(r.TableCode ?? "(chưa có bàn)")</h2>
<p class="text-muted">Thời gian hiển thị theo giờ Việt Nam · Asia/Ho_Chi_Minh (UTC+7).</p>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<section class="reservation-section" aria-labelledby="reservation-info-title">
    <h3 id="reservation-info-title" class="reservation-section-title">Thông tin đặt bàn</h3>
    <dl class="row">
        <dt class="col-sm-3">Mã đặt bàn (mã bàn)</dt>
        <dd class="col-sm-9">
            @if (r.TableCode is null)
            {
                <span class="text-muted">Chưa có bàn</span>
            }
            else
            {
                <strong class="reservation-table-code" data-table-code="@r.TableCode">@r.TableCode</strong>
                @if (r.TableAreaName is not null) { <span class="text-muted">· @r.TableAreaName</span> }
            }
        </dd>
        <dt class="col-sm-3">Khách hàng</dt><dd class="col-sm-9">@r.CustomerName</dd>
        <dt class="col-sm-3">Số điện thoại</dt><dd class="col-sm-9">@r.Phone</dd>
        <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(r.Email) ? "Không có" : r.Email)</dd>
        <dt class="col-sm-3">Số khách</dt><dd class="col-sm-9">@r.GuestCount</dd>
        <dt class="col-sm-3">Khu vực khi đặt bàn</dt><dd class="col-sm-9">@(r.AreaName ?? "Không yêu cầu")</dd>
        <dt class="col-sm-3">Bắt đầu</dt><dd class="col-sm-9">@r.StartsAt.ToString("dd/MM/yyyy HH:mm")</dd>
        <dt class="col-sm-3">Kết thúc</dt><dd class="col-sm-9">@r.EndsAt.ToString("dd/MM/yyyy HH:mm")</dd>
        <dt class="col-sm-3">Ghi chú</dt><dd class="col-sm-9 text-break">@(string.IsNullOrWhiteSpace(r.Notes) ? "Không có" : r.Notes)</dd>
        <dt class="col-sm-3">Trạng thái đặt bàn</dt>
        <dd class="col-sm-9"><span class="reservation-status" data-reservation-status="@r.Status">@r.StatusLabel</span></dd>
        @if (r.ConfirmationEmailLabel is string emailLabel)
        {
            @* S2-09 Task 2: cập nhật sau mỗi lần thử gửi email xác nhận. *@
            <dt class="col-sm-3">Trạng thái email xác nhận</dt>
            <dd class="col-sm-9" data-confirmation-email="@r.ConfirmationEmailStatus">@emailLabel</dd>
        }
        @if (r.Status == "Cancelled" && !string.IsNullOrWhiteSpace(r.CancelReason))
        {
            <dt class="col-sm-3">Lý do huỷ</dt><dd class="col-sm-9 text-break">@r.CancelReason</dd>
        }
    </dl>
</section>

@if (User.IsInRole("Manager") && r.CanDelete)
{
    @* Chỉ Quản lý: xoá hẳn lượt đặt bàn đã kết thúc khỏi danh sách. *@
    <section class="reservation-section" aria-labelledby="reservation-delete-title">
        <h3 id="reservation-delete-title" class="reservation-section-title">Xoá lượt đặt bàn</h3>
        <p class="text-muted mb-2">Lượt đặt bàn này đã kết thúc. Xoá sẽ gỡ hẳn khỏi danh sách cùng lịch sử email của lượt này.</p>
        <form asp-action="Delete" asp-route-id="@r.Id" method="post"
              data-confirm="Xoá hẳn lượt đặt bàn của @r.CustomerName (@r.StartsAt.ToString("dd/MM/yyyy HH:mm"))? Thao tác này không hoàn tác được."
              onsubmit="return confirm(this.dataset.confirm);">
            <button type="submit" class="btn btn-outline-danger">Xoá lượt đặt bàn</button>
        </form>
    </section>
}

@if (User.IsInRole("Manager") && r.CanCancel)
{
    @* Chỉ Quản lý: huỷ lượt đặt bàn, bàn được trả lại cho khách khác. *@
    <section class="reservation-section reservation-cancel" aria-labelledby="reservation-cancel-title">
        <h3 id="reservation-cancel-title" class="reservation-section-title">Huỷ đặt bàn</h3>
        <form asp-action="Cancel" asp-route-id="@r.Id" method="post" data-confirm="Huỷ lượt đặt bàn @(r.TableCode ?? r.Code) của @r.CustomerName? Thao tác này không hoàn tác được."
              onsubmit="return confirm(this.dataset.confirm);">
            <label for="cancel-reason" class="form-label">Lý do huỷ (gửi kèm email báo khách)</label>
            <textarea id="cancel-reason" name="reason" class="form-control mb-2" rows="2" maxlength="500" required
                      placeholder="Ví dụ: Khách gọi điện xin huỷ / Nhà hàng có sự cố"></textarea>
            <button type="submit" class="btn btn-danger">Huỷ đặt bàn</button>
        </form>
    </section>
}

<partial name="_EmailStatus" model="Model.Email" />

<a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>

@section Scripts {
    <script src="~/js/reservation-email-status.js" asp-append-version="true"></script>
}

@model RestaurantManagement.Web.Models.Reservations.ReminderCancelViewModel
@using RestaurantManagement.Web.Models.Reservations
@{
    ViewData["Title"] = "Huỷ đặt bàn";
    var r = Model.Reservation;
    var result = TempData[ReminderCancelViewModel.ResultKey] as string;
}
@section Styles {
    <link rel="stylesheet" href="~/css/reservation-email.css" asp-append-version="true" />
}
@* S4-08 Task 4: khách huỷ lượt đặt bàn từ đường dẫn trong email nhắc. *@
<div class="container mt-4 booking-success" style="max-width:640px" id="reminder-cancel" data-cancel-result="@result" data-can-cancel="@(Model.CanCancel ? "true" : "false")">
    <h2 class="mb-3">Huỷ đặt bàn</h2>

    @if (result == "Cancelled")
    {
        <div class="alert alert-success" role="status" data-cancel-outcome="success">@BookingReminderRules.CancelResultMessage(result)</div>
    }
    else if (result == "Error")
    {
        <div class="alert alert-danger" role="alert" data-cancel-outcome="error">Hệ thống đang bận, chưa huỷ được. Vui lòng thử lại sau ít phút hoặc gọi điện cho nhà hàng.</div>
    }
    else if (result is not null)
    {
        <div class="alert alert-warning" role="alert" data-cancel-outcome="rejected">@BookingReminderRules.CancelResultMessage(result)</div>
    }

    @if (r is null)
    {
        if (result is null)
        {
            <div class="alert alert-warning" role="alert" data-cancel-outcome="rejected">@Model.Notice</div>
        }
    }
    else
    {
        <section class="booking-code-card" aria-labelledby="booking-code-label">
            <p id="booking-code-label" class="booking-code-label">Mã đặt bàn</p>
            <p class="booking-code">@r.Code</p>
            <dl class="booking-code-facts">
                <dt>Khách hàng</dt><dd>@r.CustomerName</dd>
                <dt>Giờ hẹn</dt><dd>@RestaurantManagement.Web.Services.BookingConfirmationEmail.FormatDateTime(r.StartsAt) (giờ Việt Nam)</dd>
                <dt>Bàn</dt><dd>@(r.TableCode ?? "Chưa xếp bàn")</dd>
                <dt>Số khách</dt><dd>@r.GuestCount người</dd>
                <dt>Trạng thái</dt>
                <dd><span class="reservation-state @r.StatusCssClass" data-reservation-status="@r.Status">@r.StatusLabel</span></dd>
            </dl>
        </section>

        @if (Model.CanCancel)
        {
            <form asp-action="CancelFromEmail" method="post" class="text-center"
                  onsubmit="return confirm('Bạn chắc chắn muốn huỷ lượt đặt bàn @r.Code?');">
                <input type="hidden" name="token" value="@Model.Token" />
                <p>Bạn có chắc muốn huỷ lượt đặt bàn này? Sau khi huỷ, nhà hàng sẽ không giữ bàn cho bạn nữa.</p>
                <button type="submit" class="btn btn-danger btn-lg" data-confirm-cancel>Xác nhận huỷ</button>
            </form>
        }
        else if (result is null && Model.Notice is string notice)
        {
            <div class="alert alert-warning" role="alert" data-cancel-outcome="rejected">@notice</div>
        }
    }

    <div class="mt-3 d-flex gap-2 justify-content-center">
        <a asp-controller="Reservations" asp-action="Create" class="btn btn-outline-secondary">Đặt bàn mới</a>
        <a asp-controller="Menu" asp-action="Index" class="btn btn-outline-secondary">Xem thực đơn</a>
    </div>
</div>

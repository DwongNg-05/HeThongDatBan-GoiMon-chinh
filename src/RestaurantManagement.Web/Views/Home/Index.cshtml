@model RestaurantManagement.Web.Models.TableMapViewModel
@{
    ViewData["Title"] = "Sơ đồ bàn";
    var shownCount = Model.Tables.Count;
    var freeCount = Model.Tables.Count(table => table.Status == "Available");
    // Khu vực hiển thị: tất cả khu vực đang hoạt động, hoặc chỉ khu vực đang lọc (dữ liệu từ "Khu vực & bàn").
    var visibleAreas = Model.SelectedAreaId is null
        ? Model.Areas
        : Model.Areas.Where(area => area.Id == Model.SelectedAreaId).ToList();
    var isManager = User.IsInRole(RestaurantManagement.Web.Security.AppRoles.Manager);
}

<section class="map-page" data-status-api="@Url.Content("~/api/table-status")" data-details-api="@Url.Content("~/api/table-map")" data-rendered-table-count="@shownCount"
         data-reservation-alerts-api="@Url.Content("~/api/reservation-alerts")">
    <div class="map-heading">
        <div>
            <div class="eyebrow">VẬN HÀNH NHÀ HÀNG <span>•</span> HÔM NAY</div>
            <h1>Sơ đồ bàn</h1>
            <p class="map-subtitle">Theo dõi nhanh tình trạng bàn tại các khu vực.</p>
        </div>
        <div class="map-summary"><span class="summary-icon"><i class="fa-solid fa-table-cells-large" aria-hidden="true"></i></span><span><strong>@Model.TotalCount</strong><small>bàn trong nhà hàng</small></span></div>
    </div>

    <div class="map-toolbar">
        <nav class="area-tabs" aria-label="Lọc theo khu vực">
            <a class="area-tab @(Model.SelectedAreaId is null ? "active" : "")" asp-action="Index" aria-current="@(Model.SelectedAreaId is null ? "page" : null)">Tất cả <span>@Model.TotalCount</span></a>
            @foreach (var area in Model.Areas)
            {
                var selected = Model.SelectedAreaId == area.Id;
                <a class="area-tab @(selected ? "active" : "")" asp-action="Index" asp-route-areaId="@area.Id" aria-current="@(selected ? "page" : null)">@area.Name <span>@area.TableCount</span></a>
            }
        </nav>
        <div class="quick-count"><i aria-hidden="true"></i><span id="available-table-count">@freeCount</span> bàn trống <span>·</span> @shownCount bàn đang xem</div>
    </div>

    @* S3-09 Task 1: đặt bàn trễ từ mốc 15 phút mà khách chưa tới — tự cập nhật (reservation-no-show.js + table-map.js),
       kèm thao tác "Đánh dấu khách không tới" (giải phóng bàn, ghi lịch sử số điện thoại). *@
    @Html.AntiForgeryToken()
    <section class="late-alerts" id="late-alerts" aria-labelledby="late-alerts-title" hidden>
        <h2 class="late-alerts-title" id="late-alerts-title"><span aria-hidden="true">⚠</span> Đặt bàn trễ quá 15 phút, khách chưa tới <span class="late-alerts-count" id="late-alerts-count"></span></h2>
        <ul class="late-alert-list" id="late-alert-list"></ul>
    </section>
    @* S3-09 Task 2: lượt đang gia hạn giữ bàn — cảnh báo tạm gỡ, hiển thị thời hạn mới; hết hạn thì trở lại khung đỏ phía trên. *@
    <section class="hold-extensions" id="hold-extensions" aria-labelledby="hold-extensions-title" hidden>
        <h2 class="hold-extensions-title" id="hold-extensions-title"><span aria-hidden="true">⏱</span> Đang gia hạn giữ bàn <span class="late-alerts-count" id="hold-extensions-count"></span></h2>
        <ul class="hold-extension-list" id="hold-extension-list"></ul>
    </section>

    @if (Model.LoadError is not null)
    {
        <div class="empty-state" role="alert"><span><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i></span><h2>Không tải được sơ đồ bàn</h2><p>@Model.LoadError</p></div>
    }
    else if (Model.Areas.Count == 0)
    {
        <div class="empty-state"><span><i class="fa-solid fa-table-cells-large" aria-hidden="true"></i></span><h2>Chưa có khu vực nào</h2>
            <p>Sơ đồ bàn lấy dữ liệu từ màn hình “Khu vực &amp; bàn”. Hãy tạo khu vực và thêm bàn để hiển thị tại đây.</p>
            @if (isManager) { <p><a asp-controller="Areas" asp-action="Index">Mở Khu vực &amp; bàn</a></p> }
        </div>
    }
    else
    {
        @foreach (var area in visibleAreas)
        {
            var areaTables = Model.Tables.Where(table => table.Area == area.Name).ToList();
            <section class="area-section" aria-labelledby="area-@area.Id">
                <div class="area-heading"><div><span class="area-mark"></span><h2 id="area-@area.Id">@area.Name</h2></div><span class="area-count">@areaTables.Count bàn</span></div>
                @if (areaTables.Count == 0)
                {
                    <p class="text-muted mb-0">Khu vực này chưa có bàn đang sử dụng.@if (isManager) { <text> </text><a asp-controller="Areas" asp-action="Index" asp-fragment="khu-vuc-@area.Id">Thêm bàn</a> }</p>
                }
                else
                {
                <div class="table-grid">
                    @foreach (var table in areaTables)
                    {
                        <article class="table-card status-@table.StatusClass" data-table-code="@table.Code" data-status="@table.Status" data-changed-at="@table.ChangedAtUtc.ToString("O")" data-upcoming-guest="@table.UpcomingGuestName" data-upcoming-starts-at="@table.UpcomingStartsAtUtc?.ToString("O")" aria-label="Bàn @table.Code, sức chứa @table.Capacity người, trạng thái @table.StatusLabel">
                            <button class="table-detail-trigger" type="button" data-open-details="@table.Code" aria-label="Xem chi tiết bàn @table.Code">
                                <span class="table-card-top"><span class="table-glyph"><i class="fa-solid fa-chair" aria-hidden="true"></i></span><span class="table-status"><i></i><span class="table-status-label">@table.StatusLabel</span></span></span>
                                <strong class="table-code">@table.Code</strong>
                                <span class="table-group-label" hidden="@(table.Group is null)">@(table.Group is null ? "" : "Nhóm " + table.Group.Label)</span>
                                <span class="table-capacity"><span class="person-icon"><i class="fa-solid fa-user-group" aria-hidden="true"></i></span> @table.Capacity chỗ</span>
                            </button>
                            <div class="table-late" data-late-slot hidden></div>
                        </article>
                    }
                </div>
                }
            </section>
        }
    }
    <div class="map-footnote"><span class="connection-indicator" id="table-map-connection" aria-hidden="true"></span><span id="table-map-connection-label" role="status" aria-live="polite">Đang kết nối sơ đồ trực tiếp…</span><span class="last-update" id="table-map-last-update">· Chưa có thay đổi mới</span></div>
</section>

<div class="table-details-overlay" id="table-details-overlay" hidden>
<section class="table-details-dialog" id="table-details-dialog" role="dialog" aria-modal="true" aria-labelledby="table-details-title" tabindex="-1">
    <header class="details-header">
        <div><span class="details-kicker">THÔNG TIN BÀN</span><h2 id="table-details-title">Chi tiết bàn</h2></div>
        <button class="details-close" id="details-close-button" type="button" data-close-details aria-label="Đóng chi tiết">×</button>
    </header>
    <div class="details-status-row"><span class="table-status" id="details-status"><i></i><span id="details-status-label"></span></span><span id="details-area"></span></div>
    <p class="details-context" id="details-context" aria-live="polite">Đang tải thông tin…</p>
    <section id="details-group" class="alert alert-info" hidden>
        <strong id="details-group-label"></strong>
        <p id="details-group-members"></p>
        <p id="details-group-main"></p>
        <a id="details-group-main-link" data-ordering-url="@Url.Page("/Ordering/Index")" href="#">Mở phiên chính để gọi món</a>
        <a id="details-group-unmerge-link" data-unmerge-url="@Url.Page("/Ordering/Unmerge")" href="#" class="btn btn-outline-danger btn-sm">Huỷ gộp nhóm bàn</a>
    </section>
    <div class="details-metrics">
        <section class="details-metric"><span id="details-person-heading">Khách đang ngồi</span><strong id="details-person">—</strong><small id="details-person-note"></small></section>
        <section class="details-metric"><span>Thời gian phục vụ</span><strong id="details-started">—</strong><small id="details-duration"></small></section>
        <section class="details-metric"><span>Tạm tính hiện tại</span><strong id="details-subtotal">—</strong><small id="details-subtotal-note"></small></section>
    </div>
    <section class="details-reservation" id="details-reservation" hidden>
        <div class="details-section-title">Đặt bàn sắp tới</div>
        <strong id="details-reservation-name"></strong>
        <span id="details-reservation-phone"></span>
        <span id="details-reservation-guests"></span>
        <time id="details-reservation-time"></time>
    </section>
    @* Món đã gọi trong phiên hiện tại, theo đợt gọi. *@
    <section class="details-orders" id="details-orders" hidden>
        <div class="details-orders-head"><div class="details-section-title">Món đã gọi</div><span id="details-orders-summary"></span></div>
        <p class="details-orders-empty" id="details-orders-empty">Phiên này chưa có món nào.</p>
        <ol class="details-order-batches" id="details-order-batches"></ol>
    </section>

    @* Gọi thêm món giữa bữa: mở màn hình Gọi món cho ĐÚNG phiên đang mở → món mới là một đợt gọi mới trong cùng phiên,
       cộng vào cùng hoá đơn (không mở hoá đơn thứ hai). Mã QR để nhân viên quét bằng điện thoại đã đăng nhập. *@
    <section class="details-add-items" id="details-add-items" hidden>
        <div class="details-add-items-text">
            <div class="details-section-title">Gọi thêm món cho phiên đang mở</div>
            <p id="details-add-items-note">Món gọi thêm được gửi bếp thành đợt mới và cộng vào cùng hoá đơn của bàn — không mở hoá đơn thứ hai.</p>
            <a class="btn btn-primary btn-sm" id="details-add-items-link" href="#"><i class="fa-solid fa-plus" aria-hidden="true"></i> Gọi thêm món</a>
        </div>
        <figure class="details-add-items-qr" id="details-add-items-qr">
            <img id="details-add-items-qr-img" alt="" width="132" height="132" />
            <figcaption>Quét bằng điện thoại nhân viên để gọi thêm món</figcaption>
        </figure>
    </section>

    <div class="details-actions">
        @* S4-01 Task 1: bàn đang phục vụ → nút "Tạm tính" mở màn hình xem trước hoá đơn tạm tính (chỉ đọc, không đổi trạng thái bàn). *@
        <a class="btn btn-primary btn-sm details-preview-link" id="details-preview-link" hidden href="#" data-preview-url="@Url.Content("~/ProvisionalBill/Preview/")">Tạm tính</a>
        @* S3-04 Task 4: bàn đang có khách → mở hoá đơn tạm tính để đối chiếu ghi chú của từng món khi mang ra. *@
        <a class="btn btn-outline-primary btn-sm details-bill-link" id="details-bill-link" hidden href="#" data-bill-url="@Url.Content("~/ProvisionalBill/Table/")">Xem hoá đơn tạm tính</a>
    </div>
    <p class="details-source" id="details-source" hidden>Dữ liệu mẫu phát triển</p>
</section>
</div>

<partial name="_TableCleaning" />
@section Scripts {
    <script src="~/js/reservation-no-show.js" asp-append-version="true"></script>
    <script src="~/js/table-map.js" asp-append-version="true"></script>
}

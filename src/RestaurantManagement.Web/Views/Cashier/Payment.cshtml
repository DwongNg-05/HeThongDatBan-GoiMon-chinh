@model RestaurantManagement.Web.Models.Cashier.CashierPaymentViewModel
@using RestaurantManagement.Web.Models.Cashier
@using System.Globalization
@{
    ViewData["Title"] = "Chốt tiền mặt";
    var number = CultureInfo.InvariantCulture;
}
@section Styles { <link rel="stylesheet" href="~/css/cashier-payment.css" asp-append-version="true" /> }

<div class="container mt-4 cashier-payment" data-screen="cashier-cash-payment" data-total="@Model.Total.ToString("0", number)">
    <div class="d-flex flex-wrap justify-content-between gap-3 align-items-start mb-3">
        <div>
            <a asp-action="Index" class="link-secondary small">← Danh sách thanh toán</a>
            <h2 class="mt-2 mb-1">Thanh toán · Bàn @Model.Session.Tables</h2>
            <p class="text-muted mb-0">@Model.Session.GuestCount khách · mở lúc @Model.Session.OpenedAt.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
        <span class="badge text-bg-light border">Chỉ đọc giá món</span>
    </div>

    @if (TempData["Success"] is string success) { <div class="alert alert-success" role="alert">@success</div> }
    @if (TempData["Error"] is string tempError) { <div class="alert alert-danger" role="alert">@tempError</div> }
    @if (Model.Error is not null) { <div class="alert alert-danger" role="alert">@Model.Error</div> }
    @if (Model.Lines.Count == 0) { <div class="alert alert-warning">Phiên chưa có món hợp lệ để thanh toán.</div> }
    @if (Model.Session.UnservedCount > 0) { <div class="alert alert-warning">Còn @Model.Session.UnservedCount món chưa phục vụ. Hãy xử lý xong trước khi thanh toán.</div> }

    <div class="row g-4">
        <section class="col-lg-7">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white"><strong>Chi tiết món</strong></div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead><tr><th>Món</th><th class="text-end">Đơn giá</th><th class="text-center">SL</th><th class="text-end">Thành tiền</th></tr></thead>
                        <tbody>
                        @foreach (var line in Model.Lines)
                        {
                            <tr>
                                <td><strong>@line.ItemName</strong><br /><small class="text-muted">@line.OriginalTableCode · @line.Unit @(line.Notes is null ? "" : "· " + line.Notes)</small>
                                    @if (line.IsChargedCancellation) { <span class="badge text-bg-warning ms-1">Đã huỷ, vẫn tính</span> }</td>
                                <td class="text-end">@Vnd.Format(line.UnitPrice)</td>
                                <td class="text-center">@line.Quantity</td>
                                <td class="text-end fw-semibold">@Vnd.Format(line.LineTotal)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
        <aside class="col-lg-5">
            <section class="card shadow-sm mb-3" aria-labelledby="discount-title">
                <div class="card-body">
                    <h3 id="discount-title" class="h5">Giảm giá</h3>
                    @if (Model.Discount is { } discount)
                    {
                        <div class="alert alert-info py-2 mb-3">
                            <strong>@discount.TypeLabel: @Vnd.Format(discount.Amount)</strong><br />
                            <small>Lý do: @discount.Reason · cập nhật @discount.UpdatedAt.ToString("HH:mm dd/MM")</small>
                        </div>
                        <form asp-action="RemoveDiscount" method="post" class="mb-3">
                            <input type="hidden" name="sessionId" value="@Model.Session.SessionId" />
                            <input type="hidden" name="requestId" value="@Model.RequestId" />
                            <button type="submit" class="btn btn-outline-danger btn-sm">Gỡ giảm giá</button>
                        </form>
                    }
                    <form asp-action="Discount" method="post" class="row g-2">
                        <input type="hidden" name="sessionId" value="@Model.Session.SessionId" />
                        <input type="hidden" name="requestId" value="@Model.RequestId" />
                        <div class="col-5"><label class="form-label" for="discountType">Loại</label>
                            <select id="discountType" name="discountType" class="form-select"><option value="Percent" selected="@(Model.Discount?.Type == "Percent" ? "selected" : null)">%</option><option value="Amount" selected="@(Model.Discount?.Type == "Amount" ? "selected" : null)">Số tiền</option></select></div>
                        <div class="col-7"><label class="form-label" for="discountValue">Giá trị</label><input id="discountValue" name="discountValue" type="number" min="1" step="1" required class="form-control" value="@(Model.Discount is { } selectedDiscount ? selectedDiscount.Value.ToString("0", number) : "")" /></div>
                        <div class="col-12"><label class="form-label" for="discountReason">Lý do giảm giá</label><input id="discountReason" name="discountReason" maxlength="500" minlength="5" required class="form-control" value="@Model.Discount?.Reason" placeholder="Ít nhất 5 ký tự" /></div>
                        <div class="col-12"><small class="text-muted">Tối đa 50% tổng tiền. Mọi thay đổi đều được lưu nhật ký.</small></div>
                        <div class="col-12"><button type="submit" class="btn btn-outline-primary btn-sm">@(Model.Discount is null ? "Áp dụng giảm giá" : "Cập nhật giảm giá")</button></div>
                    </form>
                    @if (Model.DiscountHistory.Count > 0)
                    {
                        <details class="mt-3"><summary class="small fw-semibold">Nhật ký giảm giá (@Model.DiscountHistory.Count)</summary><ul class="small mb-0 mt-2 ps-3">
                            @foreach (var item in Model.DiscountHistory) { <li>@item.ActionLabel · @item.OccurredAt.ToString("HH:mm dd/MM")@(item.Reason is null ? "" : ": " + item.Reason)</li> }
                        </ul></details>
                    }
                </div>
            </section>
            <form asp-action="Checkout" method="post" class="card shadow-sm cashier-payment__form">
                <div class="card-body">
                    <h3 class="h5">Chốt hoá đơn</h3>
                    <input type="hidden" name="sessionId" value="@Model.Session.SessionId" />
                    <input type="hidden" name="requestId" value="@Model.RequestId" />
                    <dl class="cashier-payment__summary">
                        <div><dt>Tổng tiền món</dt><dd>@Vnd.Format(Model.Session.Subtotal)</dd></div>
                        @if (Model.Discount is { } appliedDiscount) { <div><dt>Giảm giá</dt><dd>-@Vnd.Format(appliedDiscount.Amount)</dd></div> }
                        <div class="cashier-payment__total"><dt>Phải thu</dt><dd>@Vnd.Format(Model.Total)</dd></div>
                        <div><dt>Hình thức</dt><dd>Chọn bên dưới</dd></div>
                    </dl>
                    <fieldset class="mb-3"><legend class="form-label fw-semibold">Hình thức thanh toán</legend>
                        <div class="d-flex gap-3"><label class="form-check"><input class="form-check-input" type="radio" name="method" value="Cash" @(Model.Method == "Cash" ? "checked" : null) data-payment-method /> Tiền mặt</label>
                        <label class="form-check"><input class="form-check-input" type="radio" name="method" value="Transfer" @(Model.Method == "Transfer" ? "checked" : null) data-payment-method /> Chuyển khoản</label></div>
                    </fieldset>
                    <div data-cash-fields>
                        <label class="form-label fw-semibold" for="cashReceived">Tiền khách đưa (VND)</label>
                        <input id="cashReceived" name="cashReceived" type="number" min="0" step="1" inputmode="numeric" class="form-control form-control-lg" value="@Model.CashReceived.ToString("0", number)" data-cash-received />
                        <div class="form-text">Hệ thống chặn số tiền nhỏ hơn tổng phải thu.</div>
                    </div>
                    <div data-transfer-fields>
                        @if (Model.TransferQr is { } qr)
                        {
                            <div class="text-center border rounded-3 p-3 bg-light">
                                <strong>Quét QR để chuyển khoản</strong>
                                <p class="small text-muted mb-2">Số tiền và nội dung đã được điền sẵn.</p>
                                <img src="@qr.ImageUrl" width="280" height="280" class="img-fluid rounded bg-white" alt="QR chuyển khoản @qr.BankCode" referrerpolicy="no-referrer" />
                                <div class="small mt-2"><strong>@qr.BankCode</strong> · @qr.AccountNumber<br />@qr.AccountName</div>
                            </div>
                            <label class="form-label fw-semibold mt-3" for="transferReference">Nội dung chuyển khoản</label>
                            <input id="transferReference" name="transferReference" readonly class="form-control form-control-lg" maxlength="50" value="@qr.Reference" data-transfer-reference />
                            <div class="form-text">Nội dung này được ghi nhận cùng hóa đơn khi thu ngân xác nhận.</div>
                        }
                        else
                        {
                            <label class="form-label fw-semibold" for="transferReference">Mã tham chiếu chuyển khoản</label>
                            <input id="transferReference" name="transferReference" class="form-control form-control-lg" maxlength="50" value="@Model.TransferReference" placeholder="VD: MB-20261015-001" data-transfer-reference />
                            <div class="form-text">6–50 ký tự: chữ, số hoặc dấu gạch ngang.</div>
                        }
                    </div>
                    <div class="cashier-payment__change mt-3" aria-live="polite" data-change-box>
                        <span>Tiền thối lại</span><strong data-change>@Vnd.Format(Model.Change)</strong>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 mt-4" data-checkout-button @(Model.Lines.Count == 0 || Model.Session.UnservedCount > 0 ? "disabled" : null)>Chốt tiền mặt</button>
                </div>
            </form>
        </aside>
    </div>
</div>
@section Scripts {
<script>
(() => {
  const root = document.querySelector('[data-screen="cashier-cash-payment"]');
  const input = root?.querySelector('[data-cash-received]');
  const change = root?.querySelector('[data-change]');
  const methods = root?.querySelectorAll('[data-payment-method]'); const cash = root?.querySelector('[data-cash-fields]'); const transfer = root?.querySelector('[data-transfer-fields]'); const checkout = root?.querySelector('[data-checkout-button]');
  if (!root || !input || !change || !methods || !cash || !transfer) return;
  const total = Number(root.dataset.total || 0);
  const format = value => new Intl.NumberFormat('vi-VN').format(Math.max(0, value)) + ' ₫';
  const refresh = () => change.textContent = format(Number(input.value || 0) - total);
  const toggle = () => { const isCash = root.querySelector('[data-payment-method]:checked')?.value === 'Cash'; cash.hidden = !isCash; transfer.hidden = isCash; root.querySelector('[data-change-box]').hidden = !isCash; input.required = isCash; transfer.querySelector('input').required = !isCash; if (checkout) checkout.textContent = isCash ? 'Chốt tiền mặt' : 'Xác nhận chuyển khoản'; };
  input.addEventListener('input', refresh); methods.forEach(x => x.addEventListener('change', toggle)); toggle(); refresh();
})();
</script>
}

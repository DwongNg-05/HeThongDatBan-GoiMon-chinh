@model RestaurantManagement.Web.Models.Cashier.PaymentsViewModel
@using RestaurantManagement.Web.Models.Cashier
@{
    ViewData["Title"] = "Thanh toán";
}
<div class="container mt-4" data-screen="cashier-payments">
    <h2>Thanh toán</h2>
    @if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }

    @if (Model.OpenShift is null)
    {
        <p class="alert alert-warning">Chưa mở ca. <a asp-action="Shift">Mở ca</a> trước khi thanh toán.</p>
    }
    else
    {
        <p class="text-muted">Ca đang mở: <strong>@Model.OpenShift.Name</strong> · từ @Model.OpenShift.OpenedAt.ToString("dd/MM/yyyy HH:mm") · @Model.OpenShift.InvoiceCount hoá đơn.</p>
    }

    @if (Model.Sessions.Count == 0)
    {
        <p class="text-muted">Không có bàn nào đang chờ thanh toán.</p>
    }
    else
    {
        <table class="table table-bordered align-middle">
            <thead><tr><th>Bàn</th><th>Số khách</th><th>Trạng thái</th><th>Số món</th><th>Tạm tính</th><th>Thanh toán</th></tr></thead>
            <tbody>
                @foreach (var s in Model.Sessions)
                {
                    <tr data-session-id="@s.SessionId">
                        <td class="fw-bold">@s.Tables</td>
                        <td>@s.GuestCount</td>
                        <td>@s.StatusLabel</td>
                        <td>@s.ItemCount @if (s.UnservedCount > 0) { <span class="text-danger">(@s.UnservedCount món chưa mang ra)</span> }</td>
                        <td>@Vnd.Format(s.Subtotal)<br /><a class="small" href="@Url.Content($"~/ProvisionalBill/{s.SessionId}")" data-bill-link="@s.SessionId">Xem hoá đơn tạm tính</a></td>
                        <td>
                            @if (s.CanCheckout && Model.OpenShift is not null)
                            {
                                <a class="btn btn-sm btn-primary" asp-action="Payment" asp-route-sessionId="@s.SessionId">Mở thanh toán tiền mặt</a>
                            }
                            else if (s.UnservedCount > 0)
                            {
                                <span class="text-muted">Chờ phục vụ mang hết món ra.</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

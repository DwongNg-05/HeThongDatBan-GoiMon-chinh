@model RestaurantManagement.Web.Models.Cashier.InvoicesViewModel
@using RestaurantManagement.Web.Models.Cashier
@{
    ViewData["Title"] = "Hoá đơn";
}
<div class="container mt-4" data-screen="cashier-invoices">
    <h2>Hoá đơn</h2>
    @if (TempData["Success"] is string success) { <div class="alert alert-success" role="alert">@success</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-auto">
            <label for="date" class="form-label">Ngày</label>
            <input id="date" name="date" type="date" class="form-control" value="@Model.BusinessDate.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-auto"><button type="submit" class="btn btn-secondary">Xem</button></div>
    </form>
    <p>Ngày @Model.BusinessDate.ToString("dd/MM/yyyy"): <strong>@Model.Invoices.Count</strong> hoá đơn, đã thu <strong>@Vnd.Format(Model.PaidTotal)</strong>.</p>
    @if (Model.Invoices.Count == 0)
    {
        <p class="text-muted">Chưa có hoá đơn.</p>
    }
    else
    {
        <div class="table-responsive"><table class="table table-bordered align-middle">
            <thead><tr><th>Số hoá đơn</th><th>Bàn</th><th>Số khách</th><th>Giờ</th><th>Tạm tính</th><th>Giảm giá</th><th>Tổng</th><th>Hình thức</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
            <tbody>
                @foreach (var i in Model.Invoices)
                {
                    <tr data-invoice="@i.InvoiceNumber">
                        <td class="fw-bold">@i.InvoiceNumber</td>
                        <td>@i.Tables</td>
                        <td>@i.GuestCount</td>
                        <td>@i.IssuedAt.ToString("HH:mm")</td>
                        <td>@Vnd.Format(i.Subtotal)</td>
                        <td>@Vnd.Format(i.DiscountAmount)</td>
                        <td>@Vnd.Format(i.Total)</td>
                        <td>@i.MethodLabel</td>
                        <td>
                            @if (i.Status == "Voided") { <span class="badge text-bg-danger">@i.StatusLabel</span><br /><small>@i.VoidedBy · @i.VoidedAt?.ToString("HH:mm")<br />@i.VoidReason</small> }
                            else { <span class="badge text-bg-success">@i.StatusLabel</span> }
                        </td>
                        <td>
                            <a asp-action="InvoiceDetails" asp-route-invoiceId="@i.Id" class="btn btn-outline-primary btn-sm mb-1">Xem chi tiết</a>
                            @if (i.Status == "Paid" && User.IsInRole("Manager"))
                            {
                                <details><summary class="btn btn-outline-danger btn-sm">Huỷ hoá đơn</summary>
                                    <form asp-action="VoidInvoice" asp-route-invoiceId="@i.Id" method="post" class="mt-2" style="min-width: 230px"
                                          data-confirm-action data-confirm="Xác nhận hủy hóa đơn @i.InvoiceNumber? Hóa đơn sẽ bị ghi nhận là đã hủy.">
                                        <input type="hidden" name="date" value="@Model.BusinessDate.ToString("yyyy-MM-dd")" />
                                        <label class="form-label small" for="reason-@i.Id">Lý do</label>
                                        <input id="reason-@i.Id" name="reason" required minlength="5" maxlength="500" class="form-control form-control-sm" placeholder="Ít nhất 5 ký tự" />
                                        <button type="submit" class="btn btn-danger btn-sm mt-2">Xác nhận huỷ</button>
                                    </form>
                                </details>
                            }
                            else if (i.Status == "Paid") { <small class="text-muted">Chỉ Quản lý</small> }
                        </td>
                    </tr>
                }
            </tbody>
        </table></div>
    }
</div>

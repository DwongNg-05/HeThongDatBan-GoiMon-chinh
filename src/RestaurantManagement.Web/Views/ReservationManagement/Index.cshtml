@model DateOnly
@{
    ViewData["Title"] = "Danh sách đặt bàn";
}

<section id="daily-reservations"
         data-url="@Url.Action("Daily")"
         data-date="@Model.ToString("yyyy-MM-dd")"
         data-follow-today="true"
         data-reservation-alerts-api="@Url.Content("~/api/reservation-alerts")">
    @* S3-09 Task 1–2: mã chống giả mạo cho "Đánh dấu khách không tới" và "Gia hạn 15 phút" (reservation-no-show.js). *@
    @Html.AntiForgeryToken()
    <partial name="_ReservationManagementTabs" />
    <header class="staff-page-head">
        <div>
            <h1>Danh sách đặt bàn</h1>
            <p>Xem lịch hẹn để chuẩn bị bàn đầu ca.</p>
        </div>
        <div class="staff-page-actions">
            <a asp-controller="ReservationConfirmations" asp-action="Index" class="btn btn-outline-primary"><i class="fa-regular fa-clock" aria-hidden="true"></i> Xử lý đơn chờ</a>
            @if (User.IsInRole("Manager")) { <a asp-controller="TableReservationSchedule" asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus" aria-hidden="true"></i> Tạo lượt thủ công</a> }
        </div>
    </header>

    <form id="reservation-date-form" class="staff-toolbar">
        <div>
            <label for="reservation-date" class="form-label">Ngày đang xem</label>
            <input id="reservation-date" name="date" type="date" class="form-control"
                   min="1900-01-01" max="9998-12-31" value="@Model.ToString("yyyy-MM-dd")" required />
        </div>
        <div>
            <label for="reservation-status" class="form-label">Trạng thái</label>
            <select id="reservation-status" name="status" class="form-select">
                <option value="">Tất cả trạng thái</option>
                <option value="Pending">Chờ xác nhận</option>
                <option value="Confirmed">Đã xác nhận</option>
                <option value="Cancelled">Đã huỷ</option>
                <option value="NoShow">Khách không tới</option>
            </select>
        </div>
        <div class="staff-toolbar-buttons">
            <button class="btn btn-primary" type="submit"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Xem danh sách</button>
            <button id="reservation-clear-filter" class="btn btn-outline-secondary" type="button">Bỏ lọc</button>
            <button id="reservation-today" class="btn btn-outline-secondary" type="button">Hôm nay</button>
        </div>
    </form>

    <div class="staff-list-meta">
        <p class="staff-list-date"><i class="fa-regular fa-calendar" aria-hidden="true"></i> Ngày <strong id="viewing-date">@Model.ToString("dd/MM/yyyy")</strong> · Giờ Việt Nam (UTC+7)</p>
        <p class="staff-list-note">Lượt trễ quá 15 phút hiện đầu danh sách (màu đỏ), tiếp theo là lượt đang gia hạn giữ bàn (kèm thời hạn mới) và lượt sắp đến trong 30 phút. Tự cập nhật mỗi 30 giây. <span id="reservation-updated" role="status"></span></p>
    </div>
    <div id="reservation-loading" class="staff-loading" role="status">Đang tải danh sách đặt bàn…</div>
    <div id="reservation-error" class="alert alert-danger" role="alert" hidden>
        <span>Không thể tải danh sách đặt bàn. Vui lòng thử lại.</span>
        <button id="reservation-retry" type="button" class="btn btn-outline-danger ms-2">Thử lại</button>
    </div>
    <p id="reservation-empty" class="staff-empty" role="status" hidden>Chưa có lượt đặt bàn trong ngày này.</p>
    <div id="reservation-results" class="table-responsive staff-table-card" hidden>
        <table class="table table-hover staff-table">
            <caption>Danh sách lượt đặt theo giờ hẹn của ngày đang xem</caption>
            <thead>
                <tr>
                    <th scope="col">Mã đặt bàn</th>
                    <th scope="col">Tên khách</th>
                    <th scope="col">Số điện thoại</th>
                    <th scope="col">Số khách</th>
                    <th scope="col">Khung giờ</th>
                    <th scope="col">Bàn đã xếp</th>
                    <th scope="col">Trạng thái</th>
                </tr>
            </thead>
            <tbody id="reservation-rows"></tbody>
        </table>
    </div>
    <noscript><p class="alert alert-warning">Vui lòng bật JavaScript để tải danh sách đặt bàn.</p></noscript>
</section>

@section Scripts {
    <script src="~/js/reservation-no-show.js" asp-append-version="true"></script>
    <script src="~/js/daily-reservations.js" asp-append-version="true"></script>
}

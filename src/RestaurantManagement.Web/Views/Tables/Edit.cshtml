@model RestaurantManagement.Web.Models.Tables.DiningTableFormViewModel
@{
    ViewData["Title"] = "Sửa bàn";
    var backUrl = Url.Action("Index", "Areas") + "#khu-vuc-" + Model.AreaId;
}
@section Styles {
    <link rel="stylesheet" href="~/css/area-tables.css" asp-append-version="true" />
}

<a href="@backUrl" class="at-back">← Quay lại Khu vực &amp; bàn</a>
<div class="at-form-card">
    <h1>Sửa bàn @Model.Code</h1>
    <p class="at-lead">Muốn chuyển bàn sang khu vực khác, chỉ cần chọn lại ô “Khu vực”.</p>
    <form asp-action="Edit" method="post">
        <input asp-for="Id" type="hidden" />
        @Html.AntiForgeryToken()
        <partial name="_Form" model="Model" />
        <div class="at-form-actions">
            <button class="btn btn-primary" type="submit">Lưu thay đổi</button>
            <a href="@backUrl" class="btn btn-outline-secondary">Quay lại</a>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary ms-sm-auto">Xem mã QR</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/table-form.js" asp-append-version="true"></script> }

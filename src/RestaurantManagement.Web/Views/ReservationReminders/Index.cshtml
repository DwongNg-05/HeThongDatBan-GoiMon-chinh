@model RestaurantManagement.Web.Models.Reservations.BookingReminderListViewModel
@using RestaurantManagement.Web.Models.Reservations
@{
    ViewData["Title"] = "Email nhắc lịch";
    var leadText = Model.LeadMinutes % 60 == 0 ? $"{Model.LeadMinutes / 60} tiếng" : $"{Model.LeadMinutes} phút";
}
@section Styles {
    <link rel="stylesheet" href="~/css/reservation-email.css" asp-append-version="true" />
}
@* S4-08 Task 1: danh sách email nhắc trước giờ hẹn (mã đặt bàn, giờ hẹn, bàn, email nhận, trạng thái gửi). *@
<partial name="_ReservationManagementTabs" />
<header class="staff-page-head">
    <div>
        <h1>Email nhắc lịch</h1>
        <p>Lượt đặt bàn đã xác nhận được gửi email nhắc trước giờ hẹn @leadText. Ngay trước khi gửi, hệ thống kiểm tra lại: lượt đã huỷ hoặc khách đã tới thì bỏ qua, không gửi. Mỗi lượt chỉ nhận tối đa một email nhắc; gửi lỗi thì tự thử lại sau 5 phút, tối đa @BookingReminderRules.MaxAttempts lần thử. Giờ hiển thị theo giờ Việt Nam (UTC+7).</p>
    </div>
    @if (User.IsInRole("Manager"))
    {
        <form class="staff-page-actions" asp-action="RunNow" method="post">
            <button type="submit" class="btn btn-primary" data-run-reminders><i class="fa-regular fa-paper-plane" aria-hidden="true"></i> Chạy kiểm tra nhắc lịch ngay</button>
        </form>
    }
</header>

@if (TempData["Success"] is string success) { <div class="alert alert-success" role="status" data-reminder-run-result>@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
@if (ViewData["LoadError"] is string loadError) { <div class="alert alert-danger" role="alert">@loadError</div> }

<form method="get" class="staff-toolbar">
    <div>
        <label for="reminder-filter" class="form-label">Hiển thị</label>
        <select id="reminder-filter" name="filter" class="form-select" onchange="this.form.submit()">
            <option value="all" selected="@(Model.Filter == BookingReminderFilter.All)">Tất cả email nhắc</option>
            <option value="sent" selected="@(Model.Filter == BookingReminderFilter.Sent)">Chỉ email đã gửi thành công</option>
            <option value="skipped" selected="@(Model.Filter == BookingReminderFilter.Skipped)">Chỉ email bị bỏ qua (lượt không còn hợp lệ)</option>
        </select>
    </div>
    <div class="staff-toolbar-buttons">
        <button class="btn btn-outline-secondary" type="submit">Làm mới</button>
    </div>
</form>

@if (Model.Items.Count == 0)
{
    <p class="staff-empty" role="status" data-reminder-empty>
        @(Model.Filter switch
        {
            BookingReminderFilter.Sent => "Chưa có email nhắc nào được gửi thành công.",
            BookingReminderFilter.Skipped => "Chưa có email nhắc nào bị bỏ qua.",
            _ => "Chưa có email nhắc lịch nào. Email được xếp khi lượt đã xác nhận còn " + leadText + " tới giờ hẹn."
        })
    </p>
}
else
{
    <p class="staff-count"><strong>@Model.Items.Count</strong> email nhắc · <strong>@Model.SentCount</strong> đã gửi thành công · <strong>@Model.SkippedCount</strong> bị bỏ qua</p>
    <div class="table-responsive staff-table-card">
        <table class="table table-hover staff-table" data-reminder-list>
            <caption>Email nhắc lịch mới nhất ở trên cùng</caption>
            <thead>
                <tr>
                    <th scope="col">Mã đặt bàn</th>
                    <th scope="col">Giờ hẹn</th>
                    <th scope="col">Bàn</th>
                    <th scope="col">Email nhận</th>
                    <th scope="col">Trạng thái lượt đặt</th>
                    <th scope="col">Trạng thái gửi</th>
                    <th scope="col">Số lần thử</th>
                    <th scope="col">Kết quả cuối cùng</th>
                    <th scope="col">Lý do bỏ qua</th>
                    <th scope="col">Gửi lúc</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr data-email-id="@item.EmailId" data-reservation-code="@item.ReservationCode" data-email-state="@item.State">
                        <td><a asp-controller="Reservations" asp-action="Details" asp-route-id="@item.ReservationId">@item.ReservationCode</a>
                            <div class="text-muted small fw-normal">@item.CustomerName</div></td>
                        <td data-field="starts-at">@item.StartsAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td data-field="table">@item.TableLabel</td>
                        <td data-field="recipient">@item.Recipient</td>
                        <td data-field="reservation-status">
                            @if (item.ReservationStatus is not null)
                            {
                                <span class="reservation-state @BookingReminderRules.ReservationStatusCss(item.ReservationStatus)">@item.ReservationStatusLabel</span>
                            }
                        </td>
                        <td>
                            <span class="email-state @item.StateCssClass">@(item.IsSkipped ? "Đã bỏ qua" : item.StateLabel)</span>
                            @if (item.ErrorMessage is not null) { <div class="reservation-email-error small text-wrap">@item.ErrorMessage</div> }
                        </td>
                        <td data-field="attempts" data-attempts="@item.AttemptCount">@item.AttemptCount/@item.MaxAttempts</td>
                        <td data-field="final-result" class="text-wrap">@item.FinalResult</td>
                        <td data-field="skip-reason" data-skip-reason="@item.SkipReason">@(item.SkipReasonLabel ?? "—")</td>
                        <td data-field="sent-at">@(item.SentAt?.ToString("dd/MM/yyyy HH:mm:ss") ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

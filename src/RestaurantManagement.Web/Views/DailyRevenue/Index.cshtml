@model RestaurantManagement.Web.Models.Reports.DailyRevenuePageModel
@{
    ViewData["Title"] = "Tổng quan doanh thu";
    var today = RestaurantManagement.Web.Models.Reservations.VietnamTime.Now.ToString("yyyy-MM-dd");
}
<div class="container mt-4" data-screen="daily-revenue">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <div><h2 class="mb-1">Tổng quan doanh thu</h2><p class="text-muted mb-0">Giờ Việt Nam (UTC+7)</p></div>
        <button type="button" class="btn btn-outline-primary" id="daily-revenue-refresh">Cập nhật ngay</button>
    </div>

    <form method="get" action="/Reports/Daily" class="row g-2 align-items-end mb-3" id="daily-revenue-filter">
        <div class="col-sm-5 col-lg-3">
            <label for="fromDate" class="form-label">Từ ngày</label>
            <input type="date" class="form-control" id="fromDate" name="fromDate" value="@Model.FromDate.ToString("yyyy-MM-dd")" max="@today" required />
        </div>
        <div class="col-sm-5 col-lg-3">
            <label for="toDate" class="form-label">Đến ngày</label>
            <input type="date" class="form-control" id="toDate" name="toDate" value="@Model.ToDate.ToString("yyyy-MM-dd")" max="@today" required />
        </div>
        <div class="col-sm-2 col-lg-2"><button type="submit" class="btn btn-primary w-100">Xem thống kê</button></div>
        <div class="col-12"><small class="text-muted">Chọn tối đa 92 ngày (tính cả ngày bắt đầu và ngày kết thúc).</small></div>
    </form>

    <div class="alert alert-danger" role="alert" id="daily-revenue-validation" @((Model.ValidationError is null) ? "hidden" : null)>@Model.ValidationError</div>
    <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2" role="alert" id="daily-revenue-refresh-error" hidden>
        <span id="daily-revenue-refresh-error-text">Không tải được số liệu mới.</span>
        <button type="button" class="btn btn-sm btn-outline-dark" id="daily-revenue-retry">Thử tải lại</button>
    </div>
    <div id="daily-revenue-dashboard">
        @if (Model.Summary is not null)
        {
            @await Html.PartialAsync("_DailyRevenueDashboard", Model)
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/daily-revenue.js" asp-append-version="true"></script>
}

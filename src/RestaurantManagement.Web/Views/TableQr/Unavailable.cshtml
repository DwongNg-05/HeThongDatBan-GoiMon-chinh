@model RestaurantManagement.Web.Models.Tables.TableQrUnavailableViewModel
@{
    ViewData["Title"] = Model.Title;
    ViewData["LightweightScripts"] = true;
}

@* S3-01 Task 1: mã QR hợp lệ nhưng bàn chưa mở được phiên gọi món mới. Không ghi gì vào database. *@
<div class="row justify-content-center mt-5">
    <div class="col-md-8 col-lg-6">
        <div class="alert alert-warning text-center p-4" role="alert" data-qr-outcome="@Model.Outcome">
            <h1 class="h4">@Model.Title</h1>
            <p class="mb-0">@Model.Message</p>
            @if (Model.CanRetry)
            {
                <form method="post" asp-controller="TableQr" asp-action="Start" asp-route-token="@Model.Token" class="mt-3">
                    <button type="submit" class="btn btn-primary">Thử lại</button>
                </form>
            }
        </div>
    </div>
</div>

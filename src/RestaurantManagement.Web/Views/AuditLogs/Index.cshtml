@model IEnumerable<RestaurantManagement.Data.Models.AuditLog>

@{
    ViewData["Title"] = "Nhật ký hệ thống";
}

<h2>Nhật ký hệ thống</h2>

<!-- Bộ lọc -->
<form method="get" class="mb-4">

    <div class="row">

        <!-- Từ ngày -->
        <div class="col-md-3">
            <label class="form-label">Từ ngày</label>
            <input type="date"
                   name="fromDate"
                   value="@ViewBag.FromDate"
                   class="form-control" />
        </div>

        <!-- Đến ngày -->
        <div class="col-md-3">
            <label class="form-label">Đến ngày</label>
            <input type="date"
                   name="toDate"
                   value="@ViewBag.ToDate"
                   class="form-control" />
        </div>

        <!-- Vai trò -->
        <div class="col-md-3">
            <label class="form-label">Vai trò</label>

            <select name="actorRole" class="form-select">

                <option value="">-- Tất cả vai trò --</option>

                @if (ViewBag.ActorRoles != null)
                {
                    foreach (var role in ViewBag.ActorRoles)
                    {
                        if (role == ViewBag.ActorRole)
                        {
                            <option value="@role" selected>
                                @role
                            </option>
                        }
                        else
                        {
                            <option value="@role">
                                @role
                            </option>
                        }
                    }
                }

            </select>
        </div>

        <!-- Nút lọc -->
        <div class="col-md-3 d-flex align-items-end">

            <button type="submit"
                    class="btn btn-primary me-2">
                Lọc
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Đặt lại
            </a>

        </div>

    </div>

</form>

<!-- Danh sách nhật ký -->
<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>Thời điểm</th>
            <th>Vai trò</th>
            <th>Hành động</th>
            <th>Loại đối tượng</th>
            <th>Mã đối tượng</th>
            <th>Lý do</th>
            <th>Địa chỉ IP</th>
        </tr>
    </thead>

    <tbody>

        @if (Model.Any())
        {
            foreach (var log in Model)
            {
                <tr>
                    <td>
                        @log.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
                    </td>

                    <td>
                        @(log.ActorRole ?? "-")
                    </td>

                    <td>
                        @log.Action
                    </td>

                    <td>
                        @log.EntityType
                    </td>

                    <td>
                        @(log.EntityId ?? "-")
                    </td>

                    <td>
                        @(log.Reason ?? "-")
                    </td>

                    <td>
                        @(log.IpAddress ?? "-")
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7"
                    class="text-center">
                    Không có dữ liệu nhật ký.
                </td>
            </tr>
        }

    </tbody>

</table>
@model List<RestaurantManagement.Web.Models.Reservations.ReservedSlot>
@{ ViewData["Title"] = "Lịch bàn đã đặt trước"; var day = (DateTime)ViewData["Day"]!; }
<h1>Lịch bàn đã đặt trước</h1>
<form method="get" class="mb-3"><label for="day">Ngày (Việt Nam)</label> <input type="date" id="day" name="day" value="@day.ToString("yyyy-MM-dd")" required /> <button class="btn btn-primary">Xem lịch</button></form>
<p>Bàn được giữ theo từng khung giờ dưới đây.</p>
@if (Model.Count == 0) { <div class="alert alert-info">Chưa có bàn được giữ trong ngày này.</div> }
else
{
<div class="table-responsive"><table class="table"><thead><tr><th>Bàn</th><th>Khu vực</th><th>Số khách / sức chứa</th><th>Khung giờ</th><th>Trạng thái</th><th>Lượt đặt</th></tr></thead><tbody>
@foreach (var row in Model)
{
<tr><td>@row.TableCode</td><td>@row.AreaName</td><td>@row.GuestCount / @row.MaxCapacity</td><td>@row.StartsAt.ToString("dd/MM HH:mm") – @row.EndsAt.ToString("dd/MM HH:mm")</td><td>Đã đặt trước</td><td><a asp-action="Details" asp-route-id="@row.Id">@row.ReservationCode</a></td></tr>
}
</tbody></table></div>
}
<a asp-action="Index">Quay lại danh sách chờ</a>

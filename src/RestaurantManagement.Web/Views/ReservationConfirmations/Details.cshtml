@model RestaurantManagement.Web.Models.Reservations.ReservationConfirmation
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{ ViewData["Title"] = "Xác nhận đặt bàn " + Model.Code; }
<h1>Lượt đặt @Model.Code</h1>
@if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<dl class="row">
<dt class="col-sm-3">Khách hàng</dt><dd class="col-sm-9">@Model.CustomerName — @Model.Phone</dd>
<dt class="col-sm-3">Số khách</dt><dd class="col-sm-9">@Model.GuestCount</dd>
<dt class="col-sm-3">Khung giờ (Việt Nam)</dt><dd class="col-sm-9">@Model.StartsAt.ToString("dd/MM/yyyy HH:mm") – @Model.EndsAt.ToString("dd/MM/yyyy HH:mm")</dd>
<dt class="col-sm-3">Khu vực mong muốn</dt><dd class="col-sm-9">@(Model.AreaName ?? "Không yêu cầu")</dd>
<dt class="col-sm-3">Trạng thái</dt><dd class="col-sm-9">@Model.StatusLabel</dd>
@if (Model.TableCode != null) { <dt class="col-sm-3">Bàn đã giữ</dt><dd class="col-sm-9">@Model.TableCode — Đã đặt trước trong khung giờ trên</dd> }
</dl>
@if(Model.Status=="Rejected")
{
<div class="alert alert-info"><strong>Lý do từ chối:</strong> @RestaurantManagement.Web.Models.Reservations.RejectionReasons.CustomerText(Model.RejectionReason)</div>
}
@if (Model.Status == "Confirmed" || Model.EmailStatus != null)
{
<div class="alert alert-info" role="status"><strong>@Model.NotificationLabel</strong>
@if (Model.EmailError != null) { <p>@Model.EmailError</p> }
@if (Model.EmailStatus == "Pending" && !Configuration.GetValue<bool>("ConfirmationEmail:Enabled")) { <p>Chức năng gửi email chưa được bật. Lượt đặt vẫn được giữ; quản lý cần cấu hình email để gửi thông báo cho khách.</p> }
</div>
}
@if (Model.CanConfirm)
{
<h2>Chọn bàn</h2>
<p>Ưu tiên khu vực khách yêu cầu. Hai lượt đặt sát giờ kết thúc và bắt đầu được phép dùng cùng bàn.</p>
@if (Model.Tables.Count == 0) { <div class="alert alert-warning">Không có bàn trống đủ chỗ trong khung giờ này. Vui lòng làm mới để kiểm tra lại.</div> }
else
{
<form asp-action="Confirm" asp-route-id="@Model.Id" method="post">
<fieldset><legend class="fs-6">Bàn còn trống, đủ chỗ</legend>
@foreach (var table in Model.Tables)
{
<div class="form-check mb-2"><input class="form-check-input" type="radio" asp-for="SelectedTableId" value="@table.Id" id="table-@table.Id" required /><label class="form-check-label" for="table-@table.Id">Bàn @table.Code — @table.MaxCapacity chỗ — @table.AreaName</label></div>
}
</fieldset>
<button type="submit" class="btn btn-primary my-3">Xác nhận và giữ bàn</button>
</form>
}
}
else if (Model.Status == "Pending") { <div class="alert alert-warning">Giờ hẹn đã qua. Không thể xác nhận lượt đặt này.</div> }
@if(Model.Status=="Pending")
{
<details class="my-4 border rounded p-3">
<summary class="text-danger">Từ chối lượt đặt</summary>
<form asp-action="Reject" asp-route-id="@Model.Id" method="post" class="mt-3">
<label for="rejection-reason" class="form-label">Lý do từ chối (bắt buộc)</label>
<select name="reason" id="rejection-reason" class="form-select" required>
<option value="">-- Chọn lý do --</option>
@foreach(var reason in RestaurantManagement.Web.Models.Reservations.RejectionReasons.Labels)
{
<option value="@reason.Key">@reason.Value</option>
}
</select>
<p class="text-muted mt-2">Khách sẽ thấy lý do này khi tra cứu lượt đặt. Không gửi thông báo tự động.</p>
<button id="submit-rejection" class="btn btn-danger" type="submit" disabled>Gửi từ chối</button>
</form>
</details>
}
<a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Làm mới</a>
<a asp-action="Index" class="btn btn-outline-secondary">Danh sách chờ</a>
<a asp-action="Schedule" asp-route-day="@Model.StartsAt.ToString("yyyy-MM-dd")" class="btn btn-outline-primary">Xem lịch giữ bàn</a>
@section Scripts { <script src="~/js/reservation-rejection.js" asp-append-version="true"></script> }

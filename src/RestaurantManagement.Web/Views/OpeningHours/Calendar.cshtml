@model RestaurantManagement.Web.Models.DailyBookingCalendarViewModel
@{ ViewData["Title"] = "Lịch nhận đặt bàn theo ngày"; }
<h1>Lịch nhận đặt bàn theo ngày</h1>
<p class="text-muted">Ngày và giờ Việt Nam · Asia/Ho_Chi_Minh (UTC+7).</p>
<p><a asp-action="Index">Giờ hoạt động</a> · <a asp-controller="SpecialHolidays" asp-action="Index">Ngày nghỉ đặc biệt</a></p>
<form method="get" asp-action="Calendar" class="mb-4">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <label asp-for="Date" class="form-label"></label>
    <input asp-for="Date" type="date" required class="form-control mb-2" style="max-width:240px" />
    <button type="submit" class="btn btn-primary">Xem khung giờ</button>
</form>
@if (Model.Date is not null && ViewData.ModelState.IsValid)
{
    <h2>@Model.Date.Value.ToString("dd/MM/yyyy")</h2>
    @if (Model.HolidayName is not null)
    {
        <div class="alert alert-info">Ngày nghỉ đặc biệt: <strong>@Model.HolidayName</strong>. Không nhận đặt bàn.</div>
    }
    else if (Model.Slots.Count == 0)
    {
        <p>Không có khung giờ nhận đặt bàn theo lịch tuần.</p>
    }
    else
    {
        <p>@Model.WeeklyDay!.DayName · @Model.WeeklyDay.OpensAt–@Model.WeeklyDay.ClosesAt</p>
        <div class="daily-booking-slots">@foreach (var slot in Model.Slots)
        { <span class="badge bg-light text-dark border me-1 mb-1">@slot</span> }</div>
    }
}

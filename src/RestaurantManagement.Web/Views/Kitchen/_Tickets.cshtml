@model RestaurantManagement.Web.Models.Kitchen.KitchenScreenViewModel
<div data-kitchen-queue-snapshot>
@if (Model.Tickets.Count == 0)
{
    <p class="text-muted">Chưa có món nào cần chế biến.</p>
}
else
{
    <div class="row g-3" data-kitchen-tickets>
        @foreach (var ticket in Model.Tickets)
        {
            var isOverdue = ticket.IsOverdue;
            <section class="col-12" data-kitchen-ticket="@ticket.BatchId">
                <article class="card @(isOverdue ? "border-danger bg-danger-subtle" : "")" data-overdue="@(isOverdue ? "true" : "false")">
                    <header class="card-header d-flex flex-wrap justify-content-between gap-2 @(isOverdue ? "text-bg-danger" : "")">
                        <strong>Bàn @ticket.TableCode · Đợt gọi @ticket.BatchNumber</strong>
                        <span>@ticket.ReceivedAtVietnam.ToString("dd/MM/yyyy HH:mm:ss") · @ticket.StatusLabel
                            @if (isOverdue) { <span class="badge bg-light text-danger ms-1">Quá hạn</span> }
                        </span>
                    </header>
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle mb-0 kitchen-item-table">
                            <thead><tr><th class="kitchen-col-name">Món</th><th class="kitchen-col-quantity">Số lượng</th><th class="kitchen-col-notes">Ghi chú</th><th class="kitchen-col-status">Trạng thái</th>@if (Model.CanChangeStatus) { <th class="kitchen-col-action"></th> }</tr></thead>
                            <tbody>
                                @foreach (var item in ticket.Items)
                                {
                                    <tr data-order-item="@item.Id" data-status="@item.Status">
                                        <td class="kitchen-col-name"><span class="kitchen-dish-name">@item.ItemName</span><small class="text-muted">(~@item.EstimatedPrepMinutes phút)</small></td>
                                        <td class="kitchen-col-quantity">@item.Quantity @item.Unit</td>
                                        <td class="kitchen-col-notes">@(string.IsNullOrWhiteSpace(item.Notes) ? "—" : item.Notes)</td>
                                        <td class="kitchen-col-status">@item.StatusLabel</td>
                                        @if (Model.CanChangeStatus)
                                        {
                                            <td class="kitchen-col-action">
                                                @if (item.NextStatus is not null)
                                                {
                                                    <form asp-action="Advance" asp-route-id="@item.Id" method="post" class="d-inline">
                                                        <input type="hidden" name="toStatus" value="@item.NextStatus" />
                                                        <button type="submit" class="btn btn-sm btn-primary">@item.NextLabel</button>
                                                    </form>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </article>
            </section>
        }
    </div>
}
</div>

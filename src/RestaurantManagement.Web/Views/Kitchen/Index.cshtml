@model RestaurantManagement.Web.Models.Kitchen.KitchenScreenViewModel

@{
    ViewData["Title"] = "Màn hình bếp";
    var batches = Model.Batches;
}

<div class="container mt-4"
     data-screen="kitchen-orders"
     data-refresh-url="@Url.Action("Index", "Kitchen")">

    <h2>Màn hình bếp</h2>

    <p class="text-muted">
        Món được chia theo từng đợt gọi của mỗi phiên.
        Thời gian hiển thị theo giờ Việt Nam (UTC+7).
        Hết nguyên liệu? Báo
        <a asp-controller="Kitchen" asp-action="Dishes">
            tạm hết trong Món trong ngày
        </a>.
    </p>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="status">
            @success
        </div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger" role="alert">
            @error
        </div>
    }

    @if (!Model.CanChangeStatus)
    {
        <p class="alert alert-secondary">
            Bạn đang xem màn hình bếp; chỉ tài khoản Bếp
            được chuyển trạng thái chế biến.
        </p>
    }

    <div id="kitchen-sync-message"
         class="alert alert-warning"
         role="status"
         aria-live="polite"
         hidden>
    </div>

    <p class="text-muted">
        Danh sách tự cập nhật mỗi 3 giây.
        Các đợt trước được giữ trong phiên chưa đóng.
    </p>

    <div id="kitchen-batches">
        @if (batches.Count == 0)
        {
            <p class="text-muted">
                Chưa có đợt gọi món nào trong các phiên đang mở.
            </p>
        }
        else
        {
            @foreach (var batch in batches)
            {
                <section class="card mb-4"
                         data-session-id="@batch.SessionId"
                         data-batch-id="@batch.BatchId"
                         data-batch-number="@batch.BatchNumber">

                    <div class="card-header">
                        <h3 class="h5 mb-1">
                            Bàn @batch.TableCodes — @batch.Label
                        </h3>

                        <div class="text-muted small">
                            Phiên #@batch.SessionId
                            · Gửi lúc
                            @batch.SubmittedAt.ToString("dd/MM/yyyy HH:mm:ss")
                            (giờ Việt Nam)
                        </div>
                    </div>

                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-bordered align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Bàn</th>
                                        <th>Món</th>
                                        <th>Số lượng</th>
                                        <th>Ghi chú</th>
                                        <th>Dự kiến chế biến</th>
                                        <th>Trạng thái</th>

                                        @if (Model.CanChangeStatus)
                                        {
                                            <th>Thao tác</th>
                                        }
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in batch.Items)
                                    {
                                        <tr data-order-item="@item.Id"
                                            data-status="@item.Status">

                                            <td class="fw-bold">
                                                @item.TableCode
                                            </td>

                                            <td>@item.ItemName</td>

                                            <td>
                                                @item.Quantity @item.Unit
                                            </td>

                                            <td class="text-break">
                                                @item.Notes
                                            </td>

                                            <td>
                                                Khoảng @item.EstimatedPrepMinutes phút
                                            </td>

                                            <td>@item.StatusLabel</td>

                                            @if (Model.CanChangeStatus)
                                            {
                                                <td>
                                                    @if (item.NextStatus is not null)
                                                    {
                                                        <form asp-controller="Kitchen"
                                                              asp-action="Advance"
                                                              asp-route-id="@item.Id"
                                                              method="post"
                                                              class="d-inline">

                                                            <input type="hidden"
                                                                   name="toStatus"
                                                                   value="@item.NextStatus" />

                                                            <button type="submit"
                                                                    class="btn btn-sm btn-primary">
                                                                @item.NextLabel
                                                            </button>
                                                        </form>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const screen = document.querySelector(
                '[data-screen="kitchen-orders"]'
            );

            if (!screen) return;

            const batches = document.getElementById('kitchen-batches');
            const message = document.getElementById('kitchen-sync-message');
            const refreshUrl = screen.dataset.refreshUrl;

            let loading = false;
            let submitting = false;

            screen.addEventListener('submit', event => {
                if (!(event.target instanceof HTMLFormElement)) return;

                if (submitting) {
                    event.preventDefault();
                    return;
                }

                submitting = true;

                event.target
                    .querySelectorAll('button[type="submit"]')
                    .forEach(button => {
                        button.disabled = true;
                    });
            });

            async function refresh() {
                if (loading || submitting || document.hidden) return;

                // Giữ nguyên giao diện khi người dùng đang chọn thao tác.
                if (batches.contains(document.activeElement)) return;

                loading = true;

                const controller = new AbortController();
                const timeout = window.setTimeout(
                    () => controller.abort(),
                    10000
                );

                try {
                    const response = await fetch(refreshUrl, {
                        method: 'GET',
                        credentials: 'same-origin',
                        cache: 'no-store',
                        signal: controller.signal
                    });

                    const expectedUrl = new URL(
                        refreshUrl,
                        window.location.href
                    );

                    const actualUrl = new URL(response.url);

                    if (!response.ok ||
                        actualUrl.origin !== expectedUrl.origin ||
                        actualUrl.pathname !== expectedUrl.pathname) {
                        throw new Error('Không tải được màn hình bếp.');
                    }

                    const html = await response.text();

                    const documentSnapshot = new DOMParser()
                        .parseFromString(html, 'text/html');

                    const nextBatches = documentSnapshot.querySelector(
                        '#kitchen-batches'
                    );

                    if (!nextBatches) {
                        throw new Error('Dữ liệu màn hình bếp không hợp lệ.');
                    }

                    if (submitting ||
                        batches.contains(document.activeElement)) {
                        return;
                    }

                    if (batches.innerHTML !== nextBatches.innerHTML) {
                        batches.innerHTML = nextBatches.innerHTML;
                    }

                    message.hidden = true;
                } catch {
                    if (!submitting) {
                        message.textContent =
                            'Chưa cập nhật được dữ liệu. ' +
                            'Danh sách hiện tại vẫn được giữ; ' +
                            'hệ thống sẽ tự thử lại.';

                        message.hidden = false;
                    }
                } finally {
                    window.clearTimeout(timeout);
                    loading = false;
                }
            }

            window.setInterval(refresh, 3000);
        })();
    </script>
}
@model RestaurantManagement.Web.Models.Kitchen.KitchenScreenViewModel
@{
    ViewData["Title"] = "Màn hình bếp";
}
@section Styles {
    <link rel="stylesheet" href="~/css/kitchen.css" asp-append-version="true" />
}
<div class="container mt-4" data-screen="kitchen-orders">
    <h2>Màn hình bếp</h2>
    <p class="text-muted">Món đang chờ, đang nấu và đã xong của các bàn đang phục vụ. Giờ Việt Nam (UTC+7).
        Hết nguyên liệu? Báo <a asp-action="Dishes">tạm hết trong Món trong ngày</a>.</p>
    @if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
    @if (!Model.CanChangeStatus)
    {
        <p class="alert alert-secondary">Bạn đang xem màn hình bếp; chỉ tài khoản Bếp được chuyển trạng thái chế biến.</p>
    }

    @if (Model.Items.Count == 0)
    {
        <p class="text-muted">Chưa có món nào cần chế biến.</p>
    }
    else
    {
        @* S3-03 Task 3: yêu cầu riêng (lựa chọn nhanh + ghi chú) nằm ngay dưới tên món, chữ to, ngắt dòng đầy đủ — không cắt chữ.
           Mỗi dòng đơn là một dòng ở đây: hai dòng cùng món nhưng khác ghi chú không bị gộp. *@
        <div class="table-responsive kitchen-orders">
        <table class="table table-bordered align-middle kitchen-table">
            <thead>
                <tr><th>Bàn</th><th>Món &amp; yêu cầu riêng</th><th>Số lượng</th><th>Gửi lúc</th><th>Trạng thái</th>@if (Model.CanChangeStatus) { <th></th> }</tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr data-order-item="@item.Id" data-status="@item.Status">
                        <td class="fw-bold">@item.TableCode</td>
                        <td class="kitchen-dish">
                            <strong class="kitchen-dish-name" data-kitchen-name>@item.ItemName</strong>
                            @if (item.HasRequests)
                            {
                                <div class="kitchen-requests" data-kitchen-requests>
                                    @if (item.QuickNoteLabels.Count > 0)
                                    {
                                        <ul class="kitchen-quick" aria-label="Lựa chọn nhanh">
                                            @foreach (var quick in item.QuickNoteLabels)
                                            {
                                                <li data-kitchen-quick>@quick</li>
                                            }
                                        </ul>
                                    }
                                    @if (item.FreeNote is not null)
                                    {
                                        <p class="kitchen-note" data-kitchen-note><span class="kitchen-note-label">Ghi chú:</span> @item.FreeNote</p>
                                    }
                                </div>
                            }
                        </td>
                        <td class="kitchen-qty">@item.Quantity @item.Unit</td>
                        <td>@item.SubmittedAt.ToString("HH:mm") <small class="text-muted">(~@item.EstimatedPrepMinutes phút)</small></td>
                        <td>@item.StatusLabel</td>
                        @if (Model.CanChangeStatus)
                        {
                            <td>
                                @if (item.NextStatus is not null)
                                {
                                    <form asp-action="Advance" asp-route-id="@item.Id" method="post" class="d-inline">
                                        <input type="hidden" name="toStatus" value="@item.NextStatus" />
                                        <button type="submit" class="btn btn-sm btn-primary">@item.NextLabel</button>
                                    </form>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</div>

@model RestaurantManagement.Web.Models.Kitchen.KitchenScreenViewModel

@{
    ViewData["Title"] = "Màn hình bếp";
    var batches = Model.Batches;
}

@section Styles {
    <link rel="stylesheet" href="~/css/kitchen.css" asp-append-version="true" />
}

<div class="container mt-4"
     data-screen="kitchen-orders"
     data-refresh-url="@Url.Action("Index", "Kitchen")">

    <h2>Màn hình bếp</h2>

    <p class="text-muted">
        Món được chia theo từng đợt gọi của mỗi phiên.
        Thời gian hiển thị theo giờ Việt Nam (UTC+7).
        Hết nguyên liệu? Báo
        <a asp-controller="Kitchen" asp-action="Dishes">
            tạm hết trong Món trong ngày
        </a>.
    </p>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="status">
            @success
        </div>
    }

    @if (TempData["Info"] is string info)
    {
        <div class="alert alert-info" role="status">
            @info
        </div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger" role="alert">
            @error
        </div>
    }

    @if (!Model.CanChangeStatus)
    {
        <p class="alert alert-secondary">
            Bạn đang xem màn hình bếp; chỉ tài khoản Bếp
            được chuyển trạng thái chế biến.
        </p>
    }

    <div id="kitchen-sync-message"
         class="alert alert-warning"
         role="status"
         aria-live="polite"
         hidden>
    </div>

    <p class="text-muted">
        Danh sách tự cập nhật mỗi 3 giây.
        Các đợt trước được giữ trong phiên chưa đóng.
    </p>

    <div id="kitchen-batches">
        @* S3-05 Task 3: thẻ "DỪNG MÓN" — Quản lý đã huỷ (có tính tiền) món bếp đang nấu / đã xong. Nằm trong #kitchen-batches
           nên xuất hiện ở lần tải lại kế tiếp (≤ 3 giây); giữ tới khi tài khoản Bếp bấm "Đã dừng món". *@
        @if (Model.Stops.Count > 0)
        {
            <section class="kitchen-stops" id="kitchen-stop-notices" role="alert" aria-live="assertive" data-stop-count="@Model.Stops.Count">
                <h3 class="kitchen-stops-title">DỪNG MÓN — @Model.Stops.Count món vừa bị hủy</h3>
                <ul class="kitchen-stops-list">
                    @foreach (var stop in Model.Stops)
                    {
                        <li class="kitchen-stop" data-stop-item="@stop.OrderItemId" data-stop-from="@stop.FromStatus">
                            <div class="kitchen-stop-text">
                                <strong class="kitchen-stop-instruction">@stop.Instruction</strong>
                                <span class="kitchen-stop-summary">@stop.Summary</span>
                                <small class="kitchen-stop-meta">
                                    Hủy bởi @(stop.CancelledByName ?? "Quản lý") lúc @stop.CancelledAt.ToString("HH:mm:ss") · món vẫn tính tiền cho khách
                                </small>
                            </div>
                            @if (Model.CanChangeStatus)
                            {
                                <form asp-controller="Kitchen" asp-action="StopAck" asp-route-id="@stop.OrderItemId" method="post" class="kitchen-stop-ack">
                                    <button type="submit" class="btn btn-sm btn-light">Đã dừng món</button>
                                </form>
                            }
                        </li>
                    }
                </ul>
            </section>
        }

        @if (batches.Count == 0)
        {
            <p class="text-muted">
                Chưa có đợt gọi món nào trong các phiên đang mở.
            </p>
        }
        else
        {
            @foreach (var batch in batches)
            {
                <section class="card mb-4"
                         data-session-id="@batch.SessionId"
                         data-batch-id="@batch.BatchId"
                         data-batch-number="@batch.BatchNumber">

                    <div class="card-header">
                        <h3 class="h5 mb-1">
                            Bàn @batch.TableCodes — @batch.Label
                        </h3>

                        <div class="text-muted small">
                            Phiên #@batch.SessionId
                            · Gửi lúc
                            @batch.SubmittedAt.ToString("dd/MM/yyyy HH:mm:ss")
                            (giờ Việt Nam)
                        </div>
                    </div>

                    <div class="card-body p-0">
                        <div class="table-responsive kitchen-orders">
                            <table class="table table-bordered align-middle mb-0 kitchen-table">
                                <thead>
                                    <tr>
                                        <th>Bàn</th>
                                        <th>Món</th>
                                        <th>Số lượng</th>
                                        <th>Dự kiến chế biến</th>
                                        <th>Trạng thái</th>

                                        @if (Model.CanChangeStatus)
                                        {
                                            <th>Thao tác</th>
                                        }
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in batch.Items)
                                    {
                                        <tr data-order-item="@item.Id"
                                            data-status="@item.Status">

                                            <td class="fw-bold">
                                                @item.TableCode
                                            </td>

                        <td class="kitchen-dish">
                            <strong class="kitchen-dish-name" data-kitchen-name>@item.ItemName</strong>
                            @if (item.HasRequests)
                            {
                                <div class="kitchen-requests" data-kitchen-requests>
                                    @if (item.QuickNoteLabels.Count > 0)
                                    {
                                        <ul class="kitchen-quick" aria-label="Lựa chọn nhanh">
                                            @foreach (var quick in item.QuickNoteLabels)
                                            {
                                                <li data-kitchen-quick>@quick</li>
                                            }
                                        </ul>
                                    }
                                    @if (item.FreeNote is not null)
                                    {
                                        <p class="kitchen-note" data-kitchen-note><span class="kitchen-note-label">Ghi chú:</span> @item.FreeNote</p>
                                    }
                                </div>
                            }
                        </td>

                                            <td>
                                                @item.Quantity @item.Unit
                                            </td>


                                            <td>
                                                Khoảng @item.EstimatedPrepMinutes phút
                                            </td>

                                            <td>@item.StatusLabel</td>

                                            @if (Model.CanChangeStatus)
                                            {
                                                <td>
                                                    @if (item.NextStatus is not null)
                                                    {
                                                        <form asp-controller="Kitchen"
                                                              asp-action="Advance"
                                                              asp-route-id="@item.Id"
                                                              method="post"
                                                              class="d-inline">

                                                            <input type="hidden"
                                                                   name="toStatus"
                                                                   value="@item.NextStatus" />

                                                            <button type="submit"
                                                                    class="btn btn-sm btn-primary">
                                                                @item.NextLabel
                                                            </button>
                                                        </form>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const screen = document.querySelector(
                '[data-screen="kitchen-orders"]'
            );

            if (!screen) return;

            const batches = document.getElementById('kitchen-batches');
            const message = document.getElementById('kitchen-sync-message');
            const refreshUrl = screen.dataset.refreshUrl;

            let loading = false;
            let submitting = false;

            // S3-05 Task 1: món bị phục vụ huỷ phải rời màn hình trong vòng 5 giây, nên danh sách tải lại mỗi 3 giây và
            // chỉ hoãn khi đầu bếp ĐANG bấm (giữ chuột / chạm trong danh sách, cộng 0,3 giây để lượt bấm kịp xử lý) —
            // không hoãn chỉ vì một nút còn giữ focus. Sau khi cập nhật, focus trở lại nút của cùng dòng món nếu còn.
            const refreshEveryMs = 3000;
            let pressedUntil = 0;
            batches.addEventListener('pointerdown', () => { pressedUntil = Number.POSITIVE_INFINITY; });
            ['pointerup', 'pointercancel'].forEach(name => document.addEventListener(name, () => {
                if (pressedUntil === Number.POSITIVE_INFINITY) pressedUntil = Date.now() + 300;
            }));
            const pressing = () => Date.now() < pressedUntil;

            screen.addEventListener('submit', event => {
                if (!(event.target instanceof HTMLFormElement)) return;

                if (submitting) {
                    event.preventDefault();
                    return;
                }

                submitting = true;

                event.target
                    .querySelectorAll('button[type="submit"]')
                    .forEach(button => {
                        button.disabled = true;
                    });
            });

            async function refresh() {
                if (loading || submitting || document.hidden) return;

                // Giữ nguyên giao diện khi người dùng đang bấm chọn thao tác.
                if (pressing()) return;

                loading = true;

                const controller = new AbortController();
                const timeout = window.setTimeout(
                    () => controller.abort(),
                    10000
                );

                try {
                    const response = await fetch(refreshUrl, {
                        method: 'GET',
                        credentials: 'same-origin',
                        cache: 'no-store',
                        signal: controller.signal
                    });

                    const expectedUrl = new URL(
                        refreshUrl,
                        window.location.href
                    );

                    const actualUrl = new URL(response.url);

                    if (!response.ok ||
                        actualUrl.origin !== expectedUrl.origin ||
                        actualUrl.pathname !== expectedUrl.pathname) {
                        throw new Error('Không tải được màn hình bếp.');
                    }

                    const html = await response.text();

                    const documentSnapshot = new DOMParser()
                        .parseFromString(html, 'text/html');

                    const nextBatches = documentSnapshot.querySelector(
                        '#kitchen-batches'
                    );

                    if (!nextBatches) {
                        throw new Error('Dữ liệu màn hình bếp không hợp lệ.');
                    }

                    if (submitting || pressing()) {
                        return;
                    }

                    if (batches.innerHTML !== nextBatches.innerHTML) {
                        const focusedItem = batches.contains(document.activeElement)
                            ? document.activeElement.closest('[data-order-item]')?.dataset.orderItem
                            : null;

                        batches.innerHTML = nextBatches.innerHTML;

                        if (focusedItem) {
                            batches
                                .querySelector(`[data-order-item="${focusedItem}"] button`)
                                ?.focus();
                        }
                    }

                    message.hidden = true;
                } catch {
                    if (!submitting) {
                        message.textContent =
                            'Chưa cập nhật được dữ liệu. ' +
                            'Danh sách hiện tại vẫn được giữ; ' +
                            'hệ thống sẽ tự thử lại.';

                        message.hidden = false;
                    }
                } finally {
                    window.clearTimeout(timeout);
                    loading = false;
                }
            }

            window.setInterval(refresh, refreshEveryMs);

            // Quay lại thẻ màn hình bếp: tải lại ngay, không chờ chu kỳ kế tiếp.
            document.addEventListener('visibilitychange', () => {
                if (!document.hidden) refresh();
            });
        })();
    </script>
}
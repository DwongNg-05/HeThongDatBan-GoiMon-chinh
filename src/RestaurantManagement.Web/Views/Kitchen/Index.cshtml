@model RestaurantManagement.Web.Models.Kitchen.KitchenScreenViewModel
@{
    ViewData["Title"] = "Màn hình bếp";
}
<div class="container mt-4" data-screen="kitchen-orders">
    <h2>Màn hình bếp</h2>
    <p class="text-muted">Món đang chờ, đang nấu và đã xong của các bàn đang phục vụ. Giờ Việt Nam (UTC+7).
        Hết nguyên liệu? Báo <a asp-action="Dishes">tạm hết trong Món trong ngày</a>.</p>
    @if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
    @if (!Model.CanChangeStatus)
    {
        <p class="alert alert-secondary">Bạn đang xem màn hình bếp; chỉ tài khoản Bếp được chuyển trạng thái chế biến.</p>
    }

    <p class="text-muted">Mỗi phiếu là một đợt gọi món của bàn. Phiếu cũ được xếp trước; nếu trùng giờ, mã phiếu thấp hơn được xếp trước.</p>
    <div id="kitchen-ticket-list" data-refresh-url="@Url.Action("Queue", "Kitchen")">
        <partial name="_Tickets" model="Model" />
    </div>
    <p id="kitchen-update-status" class="visually-hidden" role="status" aria-live="polite"></p>
</div>
@section Scripts {
    <script>
        (() => {
            const list = document.getElementById('kitchen-ticket-list');
            const updateStatus = document.getElementById('kitchen-update-status');
            if (!list) return;

            async function refreshQueue() {
                try {
                    const response = await fetch(list.dataset.refreshUrl, {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        cache: 'no-store',
                        credentials: 'same-origin'
                    });
                    if (response.ok) {
                        const html = await response.text();
                        const oldIds = new Set(Array.from(list.querySelectorAll('[data-kitchen-ticket]'), node => node.dataset.kitchenTicket));
                        const parsed = new DOMParser().parseFromString(html, 'text/html');
                        const newIds = Array.from(parsed.querySelectorAll('[data-kitchen-ticket]'), node => node.dataset.kitchenTicket);
                        const arrivals = newIds.filter(id => !oldIds.has(id));
                        list.innerHTML = html;
                        if (arrivals.length) updateStatus.textContent = arrivals.length === 1
                            ? 'Có phiếu gọi món mới trên màn hình bếp.'
                            : `Có ${arrivals.length} phiếu gọi món mới trên màn hình bếp.`;
                    }
                } catch {
                    // A later polling pass retries; transient connection handling is out of scope for this story.
                } finally {
                    window.setTimeout(refreshQueue, 3000);
                }
            }

            window.setTimeout(refreshQueue, 3000);
        })();
    </script>
}

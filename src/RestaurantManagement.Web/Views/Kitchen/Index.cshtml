@{ ViewData["Title"] = "Màn hình bếp"; }
<div id="kitchen-board" data-can-edit="@User.IsInRole("Kitchen").ToString().ToLowerInvariant()">
    <h1>Màn hình bếp</h1>
    <p>Chuyển từng dòng món: Chờ bếp → Đang chế biến → Đã xong.</p>
    <p class="text-muted">Thời gian chế biến tính từ Bắt đầu đến Xong. Thời gian chờ bếp hiển thị riêng. Các thời điểm hiển thị theo giờ Việt Nam.</p>
    <p class="text-muted">Chỉ chuyển tiến. Nếu đã bấm nhầm, báo quản lý và phục vụ để phối hợp xử lý.</p>
    <a asp-action="Dishes">Món trong ngày · Báo tạm hết</a>
    <div id="kitchen-token" hidden>@Html.AntiForgeryToken()</div>
    <p id="kitchen-message" role="status" aria-live="polite"></p>
    <h2>Hàng đợi chế biến</h2>
    <div id="kitchen-queue">Đang tải món…</div>
    <h2>Chờ mang ra</h2>
    <p class="text-muted">Món xong trước hiển thị trước. Phục vụ xem tại mục Chờ mang ra.</p>
    <div id="kitchen-ready">Đang tải món…</div>
</div>
@section Scripts { <script src="~/js/kitchen.js" asp-append-version="true"></script> }

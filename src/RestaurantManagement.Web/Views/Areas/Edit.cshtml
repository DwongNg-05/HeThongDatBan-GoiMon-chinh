@model RestaurantManagement.Web.Models.Areas.AreaFormViewModel
@{
    ViewData["Title"] = "Sửa khu vực";
    var backUrl = Url.Action("Index") + "#khu-vuc-" + Model.Id;
}
@section Styles {
    <link rel="stylesheet" href="~/css/area-tables.css" asp-append-version="true" />
}

<a href="@backUrl" class="at-back">← Quay lại Khu vực &amp; bàn</a>
<div class="at-form-card">
    <h1>Sửa khu vực</h1>
    <p class="at-lead">Đổi tên, thứ tự hiển thị hoặc ghi chú. Các bàn trong khu vực vẫn giữ nguyên.</p>
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <partial name="_AreaFields" model="Model" />
        <div class="at-form-actions">
            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
            <a href="@backUrl" class="btn btn-outline-secondary">Quay lại</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

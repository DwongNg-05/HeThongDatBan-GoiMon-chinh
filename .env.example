# Copy to .env. Use single quotes to keep literal $ characters in passwords.
# SQL password: >= 12 characters, uppercase, lowercase, number, symbol; no double quote.
MSSQL_SA_PASSWORD=''
SIXLABORS_LICENSE_FILE=./.local/sixlabors.lic
DB_NAME=RestaurantManagement_Dev
# Express is suitable for small deployments; choose a licensed edition if needed.
MSSQL_PID=Express
# Public DNS name only, without https:// or path.
SITE_HOST=localhost
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=''
SMTP_FROM=
EMAIL_VERIFICATION_ENABLED=true
# Optional: separate least-privilege SQL login for the web app.
# RM_WEB_CONNECTION_STRING='Server=db,1433;Database=RestaurantManagement_Dev;User Id=restaurant_app;Password="...";Encrypt=True;TrustServerCertificate=True'
